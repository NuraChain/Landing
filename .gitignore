node_modules/
dist/
dist-server/
.azeroth-types/
*.local
.idea/
logs/
coverage/
artifacts/
.playwright-mcp

# Local configuration. `server/.env` will hold the admin key once the dashboard lands, so this
# line is the only thing standing between a visitor and that dashboard. `.env.example` is the
# shape and is committed on purpose; `.env` itself never is.
.env
.env.*
!.env.example

# The sqlite database and its write-ahead log: content, written at runtime and restored from a
# backup, never from the repository.
.data/

# Browser screenshots. `artifacts/` above holds the ones `qa:visual` writes; these are the
# ad-hoc ones a Playwright session drops wherever it was pointed - evidence for a person
# looking at a change, never part of the source.
*.png
!application/public/*.png
!server/content/**/*.png
.playwright-mcp/
