{
    "name": "nura-landing-application",
    "private": true,
    "version": "1.8.0",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "check": "azeroth check",
        "build": "azeroth build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:shuffle": "vitest run --sequence.shuffle",
        "test:unit": "vitest run tests/wallet.spec.ts tests/nura-link.spec.ts tests/stores.spec.ts tests/content.spec.ts tests/head.spec.ts tests/page-head.spec.ts tests/loaders.spec.ts tests/i18n.spec.ts tests/network.spec.ts",
        "test:integration": "vitest run tests/add-chain.spec.ts tests/network-section.spec.ts tests/network-http.spec.ts tests/header.spec.ts tests/components.spec.ts tests/app-shell.spec.ts tests/app.spec.ts tests/ssr.spec.ts",
        "test:fuzz": "vitest run tests/network.fuzz.spec.ts",
        "test:security": "vitest run tests/network-http.spec.ts tests/wallet.spec.ts tests/nura-link.spec.ts tests/content.spec.ts tests/app-shell.spec.ts",
        "test:i18n": "vitest run tests/i18n.spec.ts tests/direction.spec.ts tests/prepaint.spec.ts",
        "coverage": "vitest run --coverage",
        "preview": "vite preview"
    },
    "dependencies": {
        "@azerothjs/http": "2.1.0",
        "@azerothjs/kit": "2.1.0",
        "@fontsource-variable/space-grotesk": "^5.3.0",
        "@fontsource-variable/vazirmatn": "^5.3.0",
        "animejs": "^4.5.0",
        "azerothjs": "2.1.0",
        "flag-icons": "^7.5.0",
        "lenis": "^1.3.26",
        "lucide": "^1.41.0",
        "simple-icons": "^16.30.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@azerothjs/cli": "2.1.0",
        "@azerothjs/compiler": "2.1.0",
        "@azerothjs/eslint-plugin": "2.1.0",
        "@azerothjs/language-server": "2.1.0",
        "@azerothjs/testing": "2.1.0",
        "@azerothjs/typescript-plugin": "2.1.0",
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.0.0",
        "@vitest/coverage-v8": "^5.0.0",
        "eslint": "^10.10.0",
        "globals": "^17.12.0",
        "happy-dom": "^20.14.0",
        "jiti": "^2.7.0",
        "playwright": "^1.63.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.69.0",
        "vite": "^8.2.2",
        "vitest": "^5.0.0"
    }
}
