import { ApiError, client } from '../../api';
import { useLocale } from '../../stores/locale';

import { CONTROL_MONO } from './controls';

import Button from '../button.component.azeroth';

/**
 * The key form.
 *
 * Says nothing the server did not: one message for a refused key, one for a refused rate. No
 * "no such key" versus "wrong key", no length hint, no echo of what was typed - the point of a
 * single shared secret is that a failed attempt teaches nothing about the next one.
 */
export default component AdminLogin(props: { onSignedIn: () => void })
{
    const { t } = useLocale();

    state key = '';
    state busy = false;
    state error = null as string | null;

    const submit = (event: Event): void =>
    {
        event.preventDefault();

        if (busy || key.trim() === '')
        {
            return;
        }

        busy = true;
        error = null;

        client.admin.signIn({ input: { key: key.trim() } })
            .then(() =>
            {
                // Cleared on the way out, not on the way in: the value is a live credential and
                // there is no reason for it to outlive the request that spent it.
                key = '';
                props.onSignedIn();
            })
            .catch((thrown: unknown) =>
            {
                error = thrown instanceof ApiError && thrown.status === 429
                    ? t().admin.tooMany
                    : t().admin.wrongKey;
            })
            .finally(() =>
            {
                busy = false;
            });
    };

    <div class="mx-auto flex min-h-[70vh] w-full max-w-sm flex-col justify-center px-5">
        <form class="flex flex-col gap-4 rounded-2xl border border-line bg-surface p-6" onSubmit={ submit }>
            <div class="flex flex-col gap-1">
                <h1 class="text-xl font-semibold text-ink">{ () => t().admin.title }</h1>
                <p class="text-sm text-muted">{ () => t().admin.signInHint }</p>
            </div>

            <label class="flex flex-col gap-1.5">
                <span class="text-sm font-semibold text-ink">{ () => t().admin.key }</span>

                { /* `dir="ltr"` and centred: the key is a Latin/digit group whatever the
                     interface language is, and in a mirrored page an un-isolated one would
                     render its groups in the wrong order while reading identically to a
                     screen reader - the failure that looks like a typo and is not.
                     `autocomplete="off"`, because a shared operational key is not a password
                     belonging to a person and does not belong in a personal keychain. */ }
                <input
                    type="password"
                    class={ `${ CONTROL_MONO } text-center tracking-[0.2em]` }
                    dir="ltr"
                    placeholder="XXXX-XXXX-XXXX-XXXX"
                    autocomplete="off"
                    spellcheck="false"
                    value={ () => key }
                    onInput={ (event: Event) => key = (event.target as HTMLInputElement).value }
                />
            </label>

            { /* `role="alert"` so the refusal is announced: a sighted operator sees the line
                 appear, and without this a screen-reader user gets silence and an unchanged
                 form. */ }
            <Show when={ () => error !== null }>
                <p class="text-sm text-danger" role="alert">{ () => error }</p>
            </Show>

            <Button type="submit" disabled={ busy || key.trim() === '' }>
                { () => busy ? `${ t().admin.saving }…` : t().admin.signIn }
            </Button>
        </form>
    </div>
}
