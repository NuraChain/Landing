import { createSignal } from 'azerothjs';

import { Check, TriangleAlert, Wallet } from 'lucide';

import { motionOk } from '../../lib/motion';
import { addChain, type AddChainOutcome } from '../../lib/wallet';

import { useLocale } from '../../stores/locale';
import { useToasts } from '../../stores/toasts';

import Button from '../ui/button.component.azeroth';
import type { ButtonShape, ButtonSize, ButtonVariant } from '../ui/button.component.azeroth';
import { icon } from '../icons/icon';

import WalletPicker from './wallet-picker.component.azeroth';

type Status = 'idle' | 'pending' | 'added' | 'failed';

/**
 * The one-click version of the chain reference card: asks a wallet the reader NAMES to store
 * Nura Chain (EIP-3085), and answers on its own label the way CopyField confirms a copy.
 *
 * It asks which wallet first, through the picker, and that is the fix rather than a flourish.
 * This button spent six revisions trying to work out on its own which of the objects on
 * `window` was a wallet, which of them the reader meant, and what each of their refusals had
 * meant - because the injected global says none of that. The picker replaces the whole of it
 * with a question the reader can answer in one press, and the request then goes to that exact
 * provider. See lib/wallet.ts for what went with it.
 *
 * A reader with none of the three installed is not a failure case any more either: the picker
 * lists the roster with a link to each, which is a better answer than a toast saying no wallet
 * was found. The manual values remain the fallback for a wallet that refuses outright, and the
 * page still travels to them - a phone's in-app browser that will not do EIP-3085 is the one
 * case no amount of handling in lib/wallet can rescue.
 */
export default component AddChainButton(props: { size?: ButtonSize; variant?: ButtonVariant; shape?: ButtonShape })
{
    const { t } = useLocale();
    const toasts = useToasts();

    const [status, setStatus] = createSignal<Status>('idle');
    const [picking, setPicking] = createSignal(false);

    let timer = 0;

    /**
     * Send the reader to the values they can copy.
     *
     * `scrollIntoView` rather than a hash assignment: the hash may already be the one being
     * set - one of the two places this button is rendered is INSIDE the chain section - and
     * assigning a hash the document already carries fires no navigation and moves no scroll.
     * That is how this button once came to be reported as doing nothing at all. `motionOk`
     * because this IS autonomous movement: the page travels on its own after a press.
     */
    const showChainCard = (): void =>
    {
        document.getElementById('chain')?.scrollIntoView({
            behavior: motionOk() ? 'smooth' : 'auto',
            block: 'start'
        });
    };

    /** What each outcome says, and how loudly. A dismissal is not a failure and must not read as one. */
    const report = (outcome: AddChainOutcome): void =>
    {
        if (outcome === 'dismissed')
        {
            // They were asked and said no. Repeating it back as a failure would be telling
            // somebody their own decision went wrong.
            setStatus('idle');

            return;
        }

        if (outcome === 'added')
        {
            setStatus('added');
            toasts.push('success', t().addChain.done);
        }
        else
        {
            setStatus('failed');

            // `mismatch` is its own sentence on purpose. "Could not add" is the wrong thing to
            // tell somebody whose wallet already holds this chain id under another ticker:
            // that is a situation they can go and fix, and only if they are told what it is.
            toasts.push('error', outcome === 'mismatch' ? t().addChain.mismatch : t().addChain.failed);
            showChainCard();
        }

        window.clearTimeout(timer);
        timer = window.setTimeout(() => setStatus('idle'), 2600);
    };

    const run = async (rdns: string): Promise<void> =>
    {
        if (status() === 'pending')
        {
            return;
        }

        setStatus('pending');
        report(await addChain(rdns));
    };

    cleanup { window.clearTimeout(timer); }

    {/* `contents` so the wrapper adds no box of its own: this button sits in a flex row
        at both call sites, and the picker beside it is portaled out of the tree anyway. */}
    <span class="contents">
        <Button
            variant={ props.variant ?? 'secondary' }
            size={ props.size ?? 'md' }
            shape={ props.shape ?? 'rounded' }
            onClick={ () => setPicking(true) }
        >
            { () => icon(status() === 'added' ? Check : status() === 'failed' ? TriangleAlert : Wallet, 'size-[18px]') }
            { () => status() === 'added' ? t().addChain.done
                : status() === 'failed' ? t().addChain.failed
                : t().addChain.cta }
        </Button>

        <WalletPicker
            open={ picking() }
            onPick={ (rdns) => void run(rdns) }
            onClose={ () => setPicking(false) }
        />
    </span>
}
