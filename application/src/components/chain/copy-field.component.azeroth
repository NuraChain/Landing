import { Check, Copy } from 'lucide';

import { useLocale } from '../../stores/locale';
import { useToasts } from '../../stores/toasts';

import { icon } from '../icons/icon';

import IconButton from '../ui/icon-button.component.azeroth';
import Tooltip from '../ui/tooltip.component.azeroth';

/**
 * A value with a copy button that confirms itself.
 *
 * Owns its own `copied` flag rather than taking one from the parent: a shared flag across
 * a list means copying one row lights up whichever row the parent last recorded. Each
 * field answering only for itself is what makes it safe to repeat.
 */
export default component CopyField(props:
{
    value: string;
    /** Accessible name for the button, e.g. "Copy RPC endpoint". */
    copyLabel: string;
    copiedLabel: string;
    copyable?: boolean;
    /**
     * Renders the value as an external link on top of keeping it copyable. Omitted for
     * values a browser cannot open, which is most of them.
     */
    href?: string;
})
{
    const { t } = useLocale();
    const toasts = useToasts();

    state copied = false;

    let timer = 0;

    const run = async (): Promise<void> =>
    {
        try
        {
            await navigator.clipboard.writeText(props.value);

            copied = true;
            clearTimeout(timer);
            timer = setTimeout(() => { copied = false; }, 1600);
        }
        catch
        {
            /*
             * Clipboard is permission-gated and blocked in some embedded browsers.
             *
             * This used to be silent, on the grounds that the value is on screen and
             * selectable so a failure "costs convenience only". That was true of the cost and
             * wrong about the risk: the reader is not told, so they walk away believing they
             * hold an RPC endpoint or a contract address and paste whatever was in the
             * clipboard before. Saying so is the whole difference, and there is somewhere to
             * say it now.
             */
            toasts.push('error', t().toast.copyFailed);
        }
    };

    cleanup { clearTimeout(timer); }

    <div class="flex min-w-0 flex-1 items-center gap-2">
        { /* The value is pinned LTR even in Persian, where bidi would otherwise reorder a
             URL or an ID. Not cosmetic: someone pastes what they read.

             The pin goes on an inner `<bdi>`, never on the block that carries `text-start`.
             `start` resolves against the element's OWN direction, so an `ltr` block inside
             an RTL row aligns its text to the LEFT - which parked every value at the far
             edge of a 666px flex slot, up to 633px from the Persian label naming it. The
             outer span keeps the page direction so `start` means "beside the label", and
             `<bdi>` isolates the value's own bidi run inside it. Same split as the platform
             note in home.page. */ }
        <Show
            when={ () => props.href }
            fallback={ () =>
            <span class="min-w-0 flex-1 truncate text-start font-mono text-sm text-ink">
                <bdi dir="ltr">{ props.value }</bdi>
            </span>
            }
            let={ href }
        >
            <a
                href={ href }
                target="_blank"
                rel="noreferrer noopener"
                class="min-w-0 flex-1 truncate text-start font-mono text-sm text-ink underline-offset-4 transition-colors hover:text-accent hover:underline"
            >
                <bdi dir="ltr">{ props.value }</bdi>
            </a>
        </Show>

        { /* The label this control already carries, shown to the eye that cannot hear it.

             This is the site's most repeated icon-only button - once per row of the chain
             card, so five or six times on one screen - and a bare clipboard glyph is the
             kind of thing a reader is sure about only after clicking it once. The bubble
             also carries the OUTCOME: it swaps to "Copied" with the tick, which is what
             turns a silent success into a stated one for a mouse user whose pointer is
             already on the button.

             `describe={false}`: the string IS the button's accessible name, so the bubble is
             `aria-hidden` and a screen reader is not read the same words twice. */ }
        <Show when={ () => props.copyable !== false }>
            <Tooltip label={ copied ? props.copiedLabel : props.copyLabel } describe={ false } class="flex">
                <IconButton
                    label={ copied ? props.copiedLabel : props.copyLabel }
                    tone="faint"
                    onClick={ () => void run() }
                >
                    { () => copied ? icon(Check, 'size-[18px] text-accent') : icon(Copy, 'size-[18px]') }
                </IconButton>
            </Tooltip>
        </Show>
    </div>
}
