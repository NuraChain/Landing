import { For, Link } from 'azerothjs';

import { EXPLORER_URL, SOCIALS, SWAP_URL } from '../lib/content/site';

import { useSectionHref } from '../lib/section-href';
import { useLocale } from '../stores/locale';

import AddChainButton from './add-chain-button.component.azeroth';
import { brandIcon } from './brand-icon';

export default component Footer()
{
    const sectionHref = useSectionHref();

    const { locale, t } = useLocale();

    // Every other figure on the site goes through `Intl.NumberFormat`, so a raw template
    // literal here was the one number that stayed in Latin digits - "2026" sitting in a
    // Persian sentence beside a Persian-digit supply figure three sections up. Grouping is
    // off because a year is not a quantity: the default would render it "۲٬۰۲۶".
    const year = new Date().getFullYear();
    const yearLabel = (): string =>
        new Intl.NumberFormat(locale(), { useGrouping: false }).format(year);

    <footer class="border-t border-line">
        <div class="px-5 pt-14 pb-10">
            <div class="mx-auto flex max-w-5xl flex-col gap-10 sm:flex-row sm:justify-between">
                <div class="max-w-xs">
                    <a href={ () => sectionHref('top') } class="flex items-center gap-2 text-base font-semibold text-ink">
                        <img src="/icon.png" alt="" width="28" height="28" class="size-7 rounded-lg" />
                        { t().brand }
                    </a>
                    <p class="mt-3 text-sm leading-relaxed text-muted">{ t().footer.tagline }</p>

                    { /* The same one-click control as the hero, for the visitor who read the
                         whole page first and decided at the bottom. */ }
                    <div class="mt-5">
                        <AddChainButton />
                    </div>

                    <div class="mt-5 flex flex-wrap items-center gap-1">
                        <For each={ () => [...SOCIALS] } key={ (social) => social.id } let={ social }>
                            <a
                                href={ social.url }
                                target="_blank"
                                rel="noreferrer noopener"
                                aria-label={ social.label }
                                class="grid size-10 place-items-center rounded-lg text-muted transition-colors hover:bg-elevated hover:text-ink"
                            >
                                { brandIcon(social.id) }
                            </a>
                        </For>
                    </div>
                </div>

                <nav class="flex flex-1 justify-evenly gap-x-16 text-center text-sm">
                    <div>
                        <h2 class="font-semibold text-ink">{ t().footer.product }</h2>
                        <a href={ () => sectionHref('wallet') } class="mt-3 block text-muted hover:text-ink">{ t().nav.wallet }</a>
                        <a href={ SWAP_URL } target="_blank" rel="noreferrer noopener" class="mt-2 block text-muted hover:text-ink">
                            { t().nav.swap }
                        </a>
                        <a href={ () => sectionHref('tokenomics') } class="mt-2 block text-muted hover:text-ink">{ t().nav.tokenomics }</a>
                    </div>

                    <div>
                        <h2 class="font-semibold text-ink">{ t().footer.resources }</h2>
                        <a href={ () => sectionHref('chain') } class="mt-3 block text-muted hover:text-ink">{ t().nav.chain }</a>
                        <a href={ EXPLORER_URL } target="_blank" rel="noreferrer noopener" class="mt-2 block text-muted hover:text-ink">
                            { t().nav.explorer }
                        </a>
                        <Link to="/blog" class="mt-2 block text-muted hover:text-ink">{ t().blog.all }</Link>
                    </div>
                </nav>
            </div>
        </div>

        { /* Its own band rather than a rule inside the column above, so this line runs the
             full width of the viewport like every section rule on the page. Its padding is
             even at 6, because a copyright strip is a bar and not a section: carrying the
             footer's old py-14 down here left it standing taller than it reads. */ }
        <div class="border-t border-line px-5 py-6">
            <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 text-sm text-faint">
                <p>{ () => `${ yearLabel() } ${ t().brand }. ${ t().footer.rights }` }</p>

                { /* The product name stays OUTSIDE the translated string. Baked into the
                     prose it could not be a link, and every language added later would
                     have to re-embed it correctly. The explicit space hole is required:
                     markup joins two text lines with a space but drops the newline around
                     an expression, so without it this reads "Built withAzerothJS". */ }
                <p>
                    { t().footer.builtWith }
                    { ' ' }
                    { /* Underlined at rest, not only on hover: this link sits INSIDE a line of
                         prose, where colour alone is what tells it apart - and it measured 1.92:1
                         against the surrounding text, well under the 3:1 that would let colour
                         carry the distinction by itself. A standing underline is the native
                         answer and needs no ARIA. */ }
                    <a
                        href="https://github.com/AzerothJS/AzerothJS"
                        target="_blank"
                        rel="noreferrer noopener"
                        class="text-muted underline underline-offset-4 transition-colors hover:text-ink"
                    >
                        AzerothJS
                    </a>
                </p>
            </div>
        </div>
    </footer>
}
