import { For, Link, Show } from 'azerothjs';

import { Blocks, Check, CircleDollarSign, Languages, Menu, Moon, Newspaper, Search, Sun, Users, Wallet, X } from 'lucide';

import { LOCALES, nativeName, useLocale } from '../../stores/locale';
import { captureOverlay } from '../../lib/overlay';
import { useSectionHref } from '../../lib/section-href';
import { withThemeTransition } from '../../lib/theme-transition';

import IconButton from '../ui/icon-button.component.azeroth';
import Tooltip from '../ui/tooltip.component.azeroth';
import { useTheme } from '../../stores/theme';
import type { Theme } from '../../stores/theme';

import { flagSrc, preloadFlags } from '../icons/flag-icon';
import { icon } from '../icons/icon';

type SectionId = 'wallet' | 'tokenomics' | 'chain' | 'explorer' | 'social';

// Mutable, not `as const`: `<For each>` takes `unknown[]`, and a readonly tuple both
// fails to assign and collapses the row parameter to `unknown`.
const SECTIONS: SectionId[] = ['wallet', 'tokenomics', 'chain', 'explorer', 'social'];

const GLYPH: Record<Theme, typeof Moon> = { dark: Moon, light: Sun };

/**
 * One glyph per drawer row. Drawn from the vocabulary the sections themselves already use -
 * `Blocks` is the chain in both the network and explorer sections, `Wallet` and
 * `CircleDollarSign` likewise - so a mark means the same thing wherever it appears. The
 * table is a full `Record`, so a section added to `SECTIONS` without a glyph is a compile
 * error rather than a row that quietly renders short.
 */
const SECTION_GLYPH: Record<SectionId, typeof Wallet> = {
    wallet: Wallet,
    tokenomics: CircleDollarSign,
    chain: Blocks,
    explorer: Search,
    social: Users
};

/**
 * Sticky header that condenses once the page scrolls.
 *
 * Anchor navigation rather than routes: the whole landing page is one document, so a
 * router hop here would tear down and rebuild content the visitor is already looking at.
 */
export default component Header()
{
    const { t, locale, choose } = useLocale();
    const { theme, cycle } = useTheme();

    state scrolled = false;
    state menuOpen = false;
    state langOpen = false;

    effect
    {
        const onScroll = (): void => { scrolled = window.scrollY > 8; };

        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });

        cleanup { window.removeEventListener('scroll', onScroll); }
    }

    // A hash link leaves the menu open behind the section it jumped to, which reads as a
    // broken overlay on a phone.
    const jump = (): void => { menuOpen = false; };

    // Escape, the scroll lock, focus in and focus back - see lib/overlay.ts for why the four
    // are one thing.
    effect
    {
        if (!menuOpen)
        {
            return;
        }

        // The language row is one tap below the links now, and a thumb gets there faster
        // than a 79KB flag does. See preloadFlags.
        preloadFlags();

        const release = captureOverlay(() => menuOpen = false, 'nav.drawer');

        cleanup
        {
            release();
        }
    }

    // Same contract as the drawer above, and now literally the same code.
    effect
    {
        if (!langOpen)
        {
            return;
        }

        const release = captureOverlay(() => langOpen = false, '[role="dialog"]');

        cleanup
        {
            release();
        }
    }

    // The drawer and its scrim are `md:hidden`, so from 48rem up they stop being painted -
    // but `menuOpen` stayed true, and with it the scroll lock and the focus trap. Rotating a
    // phone to landscape crosses 48rem: the overlay vanished, the page underneath stayed
    // frozen, and there was nothing on screen to say why and no Escape key to reach for. The
    // width here MUST match the `md:` variants below - Tailwind's `md` is 48rem.
    effect
    {
        const wide = matchMedia('(min-width: 48rem)');
        const sync = (): void =>
        {
            if (wide.matches)
            {
                menuOpen = false;
            }
        };

        sync();
        wide.addEventListener('change', sync);

        cleanup { wide.removeEventListener('change', sync); }
    }

    const sectionHref = useSectionHref();

    const label = (id: SectionId): string => t().nav[id];

    { /* The bar is a floating card, so the surface - border, background, blur - moves to
         the INNER element and the sticky <header> stays a transparent full-width rail. It
         has to: the rail is what holds the sticky position and the side gutters, and an
         inset rounded box cannot do both jobs at once.

         The rail MUST carry a `top`, and that is not a style choice: `position: sticky`
         with `top: auto` never engages, so a rail without one is static and the header
         scrolls away with the page. It reads as "the header stopped being sticky" and
         there is nothing in the class list saying why.

         TWO NUMBERS, AND THEY MUST AGREE: `mt-4` is where the card rests, `top-4` is
         where it sticks. Any difference between them is a jump the instant you scroll, by
         exactly that difference. `top` is also not optional - `position: sticky` with
         `top: auto` never engages at all, so the rail goes static and the header scrolls
         away with the page, with nothing in the class list to say why.

         The rail still OCCUPIES its 80px (16 margin + 64 card) in the flow. The hero
         cancels that with a matching negative margin so its background can run to the top
         of the viewport behind this card - see the note on #hero. A page without that
         cancellation simply starts below the header, which is what every other route
         wants. */ }
    <header class="sticky top-4 z-50 mt-4 px-4">
        { /* The card carries a surface at BOTH scroll positions. It used to go fully
             transparent at rest, which was fine when the bar was full-bleed and its edges
             were the viewport's - but a floating card with no border and no background has
             nothing to read as inset, so at scroll 0 it just looked full width again. Rest
             is the quiet version of the same card, not the absence of one; scrolling only
             firms it up. */ }
        <div
            class={ () => 'mx-auto flex h-16 max-w-6xl items-center gap-3 rounded-2xl border px-5 transition-colors duration-300 '
                + (scrolled ? 'border-line bg-bg/85 backdrop-blur-lg' : 'border-line/60 bg-surface/60 backdrop-blur-md') }
        >
            <a href={ () => sectionHref('top') } class="me-auto flex items-center gap-2 text-base font-semibold tracking-tight text-ink">
                { /* Decorative: `alt=""` on purpose, because the brand name sits right
                     beside it inside the same link. A real alt here would make a screen
                     reader announce the name twice. */ }
                <img src="/icon.png" alt="" width="28" height="28" class="size-7 rounded-lg" />
                { t().brand }
            </a>

            <nav class="hidden items-center gap-1 md:flex" aria-label={ t().nav.wallet }>
                <For each={ SECTIONS } key={ (id) => id } let={ id }>
                    <a
                        href={ () => sectionHref(id) }
                        class="rounded-lg px-3 py-2 text-sm text-muted transition-colors hover:bg-elevated hover:text-ink"
                    >
                        { label(id) }
                    </a>
                </For>

                { /* The one nav entry that is a ROUTE rather than an anchor, so it is a <Link>.
                     `end` is off on purpose: /blog should read as current while a post is open
                     under it.

                     The colour rides on `aria-[current=page]`, not on `activeClass`, because
                     `activeClass` APPENDS - `text-muted text-ink` is two utilities of equal
                     specificity and the later one in the sheet wins regardless of which the
                     markup lists last. That race silently painted the current page muted. The
                     attribute selector outranks both, and it is the same signal a screen reader
                     is already given, so the two cannot drift apart. `activeClass` stays because
                     setting it is what makes <Link> emit `aria-current` at all. */ }
                <Link
                    to="/blog"
                    class="rounded-lg px-3 py-2 text-sm text-muted transition-colors hover:bg-elevated hover:text-ink aria-[current=page]:text-ink"
                    activeClass="is-current"
                >
                    { t().blog.all }
                </Link>
            </nav>

            { /* Both of these are `md` and up, and the drawer carries them below that. The
                 scrim covers the header, so while the drawer was open its own copies of
                 these two were behind a black sheet - a visitor who opened the menu looking
                 for the language picker could see it and not reach it. Hiding them here also
                 gives the phone bar back the width three 44px controls were taking.

                 `describe={false}`: the bubble shows the SAME string the button already
                 carries as its accessible name, for the sighted mouse user who cannot see
                 it. It is marked `aria-hidden`, since announcing it would read the words
                 twice. */ }
            <Tooltip
                label={ `${ t().theme.label }: ${ t().theme[theme()] }` }
                describe={ false }
                class="hidden md:inline-flex"
            >
                { /* `theme-trigger` locates the reveal circle's origin - the theme spreads
                     from THIS button. The swap itself goes through withThemeTransition so
                     the circular wipe is the one place theme changes are animated. */ }
                <IconButton
                    label={ `${ t().theme.label }: ${ t().theme[theme()] }` }
                    class="theme-trigger"
                    onClick={ () => withThemeTransition(() => cycle()) }
                >
                    { () => icon(GLYPH[theme()], 'size-[18px]') }
                </IconButton>
            </Tooltip>

            <Tooltip label={ t().nav.language } describe={ false } class="hidden md:inline-flex">
                <IconButton
                    label={ t().nav.language }
                    haspopup="dialog"
                    expanded={ langOpen }
                    onClick={ () => langOpen = true }
                    onIntent={ () => preloadFlags() }
                >
                    { icon(Languages, 'size-[18px]') }
                </IconButton>
            </Tooltip>

            <a
                href={ () => sectionHref('wallet') }
                class="hidden h-9 items-center rounded-lg bg-accent px-4 text-sm font-semibold text-accent-ink transition-colors hover:bg-accent-hover sm:flex"
            >
                { t().nav.download }
            </a>

            <IconButton
                label={ menuOpen ? t().nav.closeMenu : t().nav.openMenu }
                expanded={ menuOpen }
                class="md:hidden"
                onClick={ () => menuOpen = !menuOpen }
            >
                { () => icon(menuOpen ? X : Menu, 'size-5') }
            </IconButton>
        </div>

        <Show when={ menuOpen }>
            <Portal>
                { /* ONE child. `Portal` appends a single node, so handing it the scrim and
                     the panel as siblings throws at append time - the same one-element rule
                     a `<For>` row and a route component follow. The wrapper is unstyled and
                     both children are `fixed`, so it intercepts nothing. */ }
                <div class="md:hidden">
                { /* Scrim first so the panel stacks above it. Tapping it closes, which is
                     the gesture people try before hunting for an X. */ }
                    <div
                        class="fixed inset-0 z-[60] bg-black/60 backdrop-blur-sm"
                        onClick={ () => menuOpen = false }
                ></div>

                { /* Anchored to the inline-END edge, so it slides from the right in English
                     and from the LEFT in Persian. A drawer pinned to `right` would come from
                     the wrong side of an RTL page and read as a mistake. */ }
                    <nav
                        class="drawer fixed inset-y-0 end-0 z-[61] flex w-[min(19rem,85vw)] flex-col gap-1 border-s border-line bg-surface p-4 shadow-2xl overflow-y-auto overscroll-contain motion-safe:animate-[drawer_220ms_ease-out] md:hidden"
                        style="padding-top: max(1rem, env(safe-area-inset-top)); padding-bottom: max(1rem, env(safe-area-inset-bottom));"
                        aria-label={ t().nav.wallet }
                    >
                        <IconButton
                            label={ t().nav.closeMenu }
                            size="lg"
                            class="mb-2 self-end"
                            onClick={ () => menuOpen = false }
                        >
                            { icon(X, 'size-5') }
                        </IconButton>

                        { /* A divided list rather than the bar's loose row of links: at this
                             width the rows are the page's whole index, and a hairline between
                             them is what makes each one read as its own target rather than as
                             one block of words. `divide-y` puts the rule BETWEEN rows only, so
                             there is no stray line above the first or below the last, and it
                             is direction-neutral - a horizontal rule needs no RTL counterpart.
                             The group drops the nav's `gap-1` on purpose: a gap would leave
                             each rule floating in the space instead of dividing two rows. */ }
                        <div class="flex flex-col divide-y divide-line">
                            <For each={ SECTIONS } key={ (id) => id } let={ id }>
                                <a
                                    href={ () => sectionHref(id) }
                                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-base text-muted transition-colors hover:bg-elevated hover:text-ink"
                                    onClick={ () => jump() }
                                >
                                    { icon(SECTION_GLYPH[id], 'size-[18px] shrink-0') }
                                    <span>{ label(id) }</span>
                                </a>
                            </For>

                            <Link
                                to="/blog"
                                class="flex items-center gap-3 rounded-xl px-4 py-3 text-base text-muted transition-colors hover:bg-elevated hover:text-ink aria-[current=page]:text-ink"
                                activeClass="is-current"
                                onClick={ () => jump() }
                            >
                                { icon(Newspaper, 'size-[18px] shrink-0') }
                                <span>{ t().blog.all }</span>
                            </Link>
                        </div>

                        { /* Everything from here down sits at the FOOT of the drawer, which
                             is what `mt-auto` buys: the links keep their natural height at
                             the top and the whole remainder of the panel becomes one gap.
                             An auto margin rather than `justify-between` on the nav, because
                             this column also scrolls - auto margins resolve to zero once the
                             content outgrows the panel, where a distributed `justify-` would
                             still be trying to spread space that is no longer there. */ }
                        <div class="mt-auto flex flex-col gap-1 pt-6">
                            <a
                                href={ () => sectionHref('wallet') }
                                class="flex h-12 items-center justify-center rounded-xl bg-accent font-semibold text-accent-ink"
                                onClick={ () => jump() }
                            >
                                { t().nav.download }
                            </a>

                            { /* The two controls the bar gives up below `md`. Rows rather than
                                 the bar's icon buttons: there is width for a word here, and a
                                 label a thumb can read beats a glyph it has to guess at. Each
                                 row states its current value on the trailing edge, which is the
                                 same string the bar's tooltip shows on hover. */ }
                            <div class="mt-3 flex flex-col divide-y divide-line border-t border-line pt-3">
                                <button
                                    type="button"
                                    class="theme-trigger flex items-center gap-3 rounded-xl px-4 py-3 text-base text-muted transition-colors hover:bg-elevated hover:text-ink"
                                    onClick={ () => withThemeTransition(() => cycle()) }
                                >
                                    { () => icon(GLYPH[theme()], 'size-[18px] shrink-0') }
                                    <span class="flex-1 text-start">{ t().theme.label }</span>
                                    <span class="text-sm text-faint">{ () => t().theme[theme()] }</span>
                                </button>

                                { /* Opening the dialog CLOSES the drawer, deliberately: two live
                                     overlays would be two scroll locks, two Escape handlers and
                                     two focus traps fighting over the same Tab. Closing first
                                     also means `captureOverlay` reads the hamburger as the
                                     opener, so focus returns to the control that started the
                                     journey rather than to a row that no longer exists. */ }
                                <button
                                    type="button"
                                    aria-haspopup="dialog"
                                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-base text-muted transition-colors hover:bg-elevated hover:text-ink"
                                    onClick={ () => { menuOpen = false; langOpen = true; } }
                                >
                                    { icon(Languages, 'size-[18px] shrink-0') }
                                    <span class="flex-1 text-start">{ t().nav.language }</span>
                                    <span class="text-sm text-faint">{ nativeName(locale()) }</span>
                                </button>
                            </div>
                        </div>
                    </nav>
                </div>
            </Portal>
        </Show>

        { /* Ten languages outgrew a toggle, and a modal outgrew a dropdown: a centred
             dialog holds a two-column grid without fighting the header card for space, and
             it works identically at every breakpoint. Each row names its language in
             itself - a Persian speaker hunting through an English page should meet
             "فارسی", not "Persian" - and `lang` per row keeps screen readers pronouncing
             each name in its own language. Flags are `alt=""` on purpose: the name sits
             right beside them, and a flag is a scanning aid, not the information. */ }
        <Show when={ langOpen }>
            <Portal>
                { /* ONE child, same as the drawer: `Portal` appends a single node. */ }
                <div>
                    <div
                        class="fixed inset-0 z-[80] bg-black/60 backdrop-blur-sm"
                        onClick={ () => langOpen = false }
                    ></div>

                    { /* `left-1/2` with `-translate-x-1/2` is PHYSICAL on purpose and must
                         stay that way. Centring is symmetric, so it lands identically in
                         both directions; swapping in the logical `start-1/2` would resolve
                         to `right: 50%` in Persian while the transform still pulls toward
                         physical left, throwing the dialog a full half-width off centre.
                         The dialog's CONTENT still follows the document direction. */ }
                    <div
                        role="dialog"
                        aria-modal="true"
                        aria-label={ t().nav.language }
                        class="fixed left-1/2 top-1/2 z-[81] max-h-[85vh] w-[min(26rem,calc(100vw-2rem))] -translate-x-1/2 -translate-y-1/2 overflow-y-auto rounded-2xl border border-line bg-surface p-4 shadow-2xl"
                    >
                        <div class="mb-3 flex items-center justify-between gap-3">
                            <h2 class="flex items-center gap-2 font-semibold text-ink">
                                { icon(Languages, 'size-[18px]') }
                                { t().nav.language }
                            </h2>

                            <IconButton label={ t().nav.closeMenu } onClick={ () => langOpen = false }>
                                { icon(X, 'size-5') }
                            </IconButton>
                        </div>

                        <div class="grid grid-cols-2 gap-1.5">
                            <For each={ () => [...LOCALES] } key={ (id) => id } let={ id }>
                                <button
                                    type="button"
                                    lang={ id }
                                    class={ () => 'flex items-center gap-2.5 rounded-xl border px-3 py-2.5 text-sm transition-colors '
                                        + (locale() === id
                                            ? 'border-accent/50 bg-accent-soft text-ink'
                                            : 'border-transparent text-muted hover:bg-elevated hover:text-ink') }
                                    onClick={ () => { choose(id); langOpen = false; } }
                                >
                                    <img
                                        src={ flagSrc(id) }
                                        alt=""
                                        width="24"
                                        height="18"
                                        class="h-[18px] w-6 shrink-0 rounded-[4px] object-cover"
                                    />
                                    <span class="min-w-0 flex-1 truncate text-start">{ nativeName(id) }</span>
                                    <Show when={ () => locale() === id }>
                                        { icon(Check, 'size-4 shrink-0 text-accent') }
                                    </Show>
                                </button>
                            </For>
                        </div>
                    </div>
                </div>
            </Portal>
        </Show>
    </header>
}
