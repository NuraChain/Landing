import type { Child } from 'azerothjs';

import { BUTTON_SIZE, BUTTON_VARIANT, type ButtonSize, type ButtonVariant } from './variants';

export type { ButtonSize, ButtonVariant };

/** `square` drops the radius for the brutalist landing hero; every other caller keeps the default. */
export type ButtonShape = 'rounded' | 'square';

interface ButtonProps
{
    variant?: ButtonVariant;
    size?: ButtonSize;
    shape?: ButtonShape;
    /** Present means this renders an anchor. A control that navigates must BE a link, not a button that calls the router, or middle-click and open-in-new-tab both stop working. */
    href?: string;
    /** Only meaningful alongside `href`. Adds the safe rel automatically. */
    external?: boolean;
    type?: 'button' | 'submit';
    disabled?: boolean;
    ariaLabel?: string;
    class?: string;
    onClick?: () => void;
    children?: Child;
}

/**
 * The one button. Every call site was repeating the same class string, so a change to the
 * hover treatment meant finding all of them; now it lands here.
 */
export default component Button(props: ButtonProps)
{
    derived classes = 'inline-flex items-center justify-center gap-2 font-semibold transition-colors '
        + (props.shape === 'square' ? '' : 'rounded-xl ')
        + BUTTON_SIZE[props.size ?? 'md']
        + ' ' + BUTTON_VARIANT[props.variant ?? 'primary']
        + (props.disabled === true ? ' cursor-not-allowed opacity-55' : '')
        + (props.class !== undefined ? ` ${ props.class }` : '');

    <Show
        when={ () => props.href }
        fallback={ () =>
        <button
            type={ props.type ?? 'button' }
            class={ () => classes }
            disabled={ () => props.disabled === true }
            aria-label={ props.ariaLabel }
            onClick={ () => props.onClick?.() }
        >
            { props.children }
        </button>
    }
        let={ href }
    >
        <a
            href={ href }
            class={ () => classes }
            aria-label={ props.ariaLabel }
            target={ props.external === true ? '_blank' : undefined }
            rel={ props.external === true ? 'noreferrer noopener' : undefined }
        >
            { props.children }
        </a>
    </Show>
}
