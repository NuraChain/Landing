import { CONTROL, CONTROL_BODY, CONTROL_MONO } from './controls';

type Face = 'prose' | 'mono';

interface InputProps
{
    value: string;
    onInput: (value: string) => void;
    /**
     * `mono` for a value that is Latin and machine-shaped whatever the interface language is -
     * a slug, a url, a tag list. A Persian title set in the mono stack is unreadable; a slug
     * set in the Persian text face is unproofreadable.
     */
    face?: Face;
    /** A textarea rather than an input. Implies the taller box and the mono face. */
    multiline?: boolean;
    /**
     * Direction and language of the VALUE, not of the page.
     *
     * The editor writes ten languages through one set of fields, so a Persian tab has to put
     * the caret on the right while the slug beside it stays left-to-right. Passed rather than
     * inferred: an empty Persian field has no content to infer from, and `dir="auto"` would
     * start it left and flip it after the first keystroke.
     */
    dir?: 'ltr' | 'rtl';
    lang?: string;
    placeholder?: string;
    type?: string;
    autocomplete?: string;
    spellcheck?: boolean;
    /** Appended after the shared classes, for the rare field that needs a tweak. */
    class?: string;
}

/**
 * A text control.
 *
 * The class strings stay in `controls.ts` and are shared by name; this only wraps the element
 * and its binding. Deliberately NOT a `Select` as well - the fallback-language select in the
 * post editor sets `selected` on each `<option>` rather than `value` on the select, because
 * its options are built by a `<For>` and do not exist at the moment `value` would apply. A
 * component that normalised every select to `value` would silently blank that control.
 */
export default component Input(props: InputProps)
{
    derived classes = ((): string =>
    {
        const base = props.multiline === true
            ? CONTROL_BODY
            : (props.face === 'mono' ? CONTROL_MONO : CONTROL);

        return props.class === undefined ? base : `${ base } ${ props.class }`;
    })();

    <Show
        when={ () => props.multiline === true }
        fallback={ () =>
        <input
            class={ () => classes }
            type={ () => props.type ?? 'text' }
            value={ () => props.value }
            dir={ () => props.dir }
            lang={ () => props.lang }
            placeholder={ () => props.placeholder }
            autocomplete={ () => props.autocomplete }
            spellcheck={ () => props.spellcheck === false ? 'false' : undefined }
            onInput={ (event: Event) => props.onInput((event.target as HTMLInputElement).value) }
        />
    }
    >
        <textarea
            class={ () => classes }
            value={ () => props.value }
            dir={ () => props.dir }
            lang={ () => props.lang }
            placeholder={ () => props.placeholder }
            onInput={ (event: Event) => props.onInput((event.target as HTMLTextAreaElement).value) }
        ></textarea>
    </Show>
}
