import { render } from 'azerothjs';

import { initSmoothScroll } from './lib/smooth-scroll';
import { migrateLegacyChoice } from './stores/locale';

import App from './App.azeroth';

render(() => App(), document.getElementById('root')!);

// Once per page load, not per component: wheel smoothing and the hash-link glide are
// document-level concerns. Guarded internally (reduced motion, no ResizeObserver).
initSmoothScroll();

// AFTER the app is up, never during: a reader who chose a language before the server could
// see that choice has it in localStorage, and this replays it into the cookie once. Switching
// mid-mount would fight the language the server already rendered.
migrateLegacyChoice();
