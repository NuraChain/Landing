import { Link, useQuery, type NavigateTarget } from 'azerothjs';

import { blogQuery } from '../lib/blog-query';
import type { BlogIndex } from '../lib/loaders';
import { useLocalizedLoader } from '../lib/localized-loader';
import { directionOf, useLocale } from '../stores/locale';

import Banner from '../components/ui/banner.component.azeroth';
import Pagination from '../components/ui/pagination.component.azeroth';
import EmptyState from '../components/ui/empty-state.component.azeroth';
import Skeleton from '../components/ui/skeleton.component.azeroth';

const CHIP = 'border px-3 py-1.5 font-label text-xs font-medium uppercase tracking-[0.12em] transition-colors ';
const CHIP_ON = 'cursor-default border-accent bg-accent text-accent-ink';
const CHIP_OFF = 'cursor-pointer border-line text-muted hover:border-line-strong hover:text-ink';

/*
 * The count has to change colour with the chip, and that is not cosmetic.
 *
 * `--faint` is measured against the page surfaces and clears 4.5:1 on all three themes there.
 * The SELECTED chip is not a page surface - it is filled with `--accent` - and faint on accent
 * measures 1.84:1, which is a serious contrast failure sitting in plain sight. `--accent-ink`
 * is the ink the design system pairs with that fill, so the selected count uses it at full
 * strength; de-emphasising it with an opacity modifier would walk straight back toward the
 * floor it just cleared.
 */
const COUNT = 'ms-1.5 tabular-nums ';
const COUNT_ON = 'text-accent-ink';
const COUNT_OFF = 'text-faint';

/**
 * The blog index.
 *
 * The list arrives WITH the document: `routes.ts` declares the loader, so a direct load is
 * answered with the cards already in it - which is what a crawler and a reader with no
 * JavaScript get - and the browser adopts that rather than fetching the same page again.
 * The loader re-runs on its own when the url's page or tag changes, and
 * `useLocalizedLoader` re-asks on a language switch, which is the one input it cannot key on.
 */
export default component Blog()
{
    const { t, locale } = useLocale();
    const query = useQuery();

    const index = useLocalizedLoader<BlogIndex>();

    derived posts = index.data()?.rows ?? null;
    derived tags = index.data()?.tags ?? [];
    derived pageCount = index.data()?.pages ?? 1;
    /** Everything published, for the count on the unfiltered chip. */
    derived publishedCount = index.data()?.published ?? 0;
    derived failed = index.error() !== null;

    /*
     * The page and the tag live in the URL, not in state.
     *
     * So page two can be linked, bookmarked and followed by a crawler back through older
     * posts, and so Back steps through the pages rather than leaving the blog entirely. It
     * also means there is one source of truth for both: the address bar - and the LOADER
     * reads it through the same `blogQuery`, so the request and the rendered pager cannot
     * disagree about which page this is.
     */
    const tag = (): string | null => blogQuery(query()).tag;
    const page = (): number => blogQuery(query()).page;

    /** Where a given page lives. Page one drops the parameter, so `/blog` stays canonical. */
    const at = (to: number): NavigateTarget =>
    {
        const parts: Record<string, string> = {};
        const only = tag();

        if (only !== null)
        {
            parts.tag = only;
        }

        if (to > 1)
        {
            parts.page = String(to);
        }

        return { pathname: '/blog', query: parts };
    };

    /**
     * Counts go through Intl too, not just dates.
     *
     * The tags endpoint has always returned `{ tag, count }` and the page printed only the
     * tag - so how much sits behind each filter was fetched on every load and thrown away.
     */
    const count = (value: number): string => new Intl.NumberFormat(locale()).format(value);

    /** Dates go through Intl in the reader's locale - no hand formatting, years included. */
    const day = (iso: string | null): string =>
        iso === null ? '' : new Intl.DateTimeFormat(locale(), { dateStyle: 'medium' }).format(new Date(iso));

    { /* `max-w-4xl` and `py-16 sm:py-20`: the same measure and the same rhythm every landing
         section uses, so the page keeps one left edge as a reader moves between them. */ }
    <section class="mx-auto flex max-w-4xl flex-col gap-8 px-5 py-16 sm:py-20">
        <header class="flex flex-col gap-3">
            { /* The rule above the heading is the SectionHeading motif, drawn here by hand: that
                 component numbers a landing section, and a route is not one of those. */ }
            <span class="h-px w-full bg-line" aria-hidden="true"></span>
            <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">{ t().blog.title }</h1>
            <p class="max-w-lg text-muted">{ t().blog.subtitle }</p>
        </header>

        <Show when={ tags.length > 0 }>
            { /* `gap` rather than margins on the children: gap is direction-neutral, so the row
                 survives Persian and Arabic without a second rule. */ }
            { /* Links, not buttons, now that the filter is in the URL: a filtered view is a
                 place, and a control that goes to a place must BE a link or middle-click and
                 open-in-new-tab stop working.

                 `aria-current` carries the selection. It used to be signalled by colour alone,
                 so the chosen filter and the rest announced identically to a screen reader. */ }
            <nav class="flex flex-wrap gap-2" aria-label={ t().blog.everyTag }>
                <Link
                    to={ () => ({ pathname: '/blog', query: {} }) }
                    class={ () => CHIP + (tag() === null ? CHIP_ON : CHIP_OFF) }
                    aria-current={ () => tag() === null ? 'true' : undefined }
                >
                    { t().blog.everyTag }
                    <span class={ () => COUNT + (tag() === null ? COUNT_ON : COUNT_OFF) }>
                        { () => count(publishedCount) }
                    </span>
                </Link>
                <For each={ tags } key={ (row) => row.tag } let={ row }>
                    <span class="contents">
                        <Link
                            to={ () => ({ pathname: '/blog', query: { tag: row.tag } }) }
                            class={ () => CHIP + (tag() === row.tag ? CHIP_ON : CHIP_OFF) }
                            aria-current={ () => tag() === row.tag ? 'true' : undefined }
                        >
                            { row.tag }
                            { /* `tabular-nums` so the chips do not jitter as counts change, and a
                                 dimmer ink so the tag stays the thing being read - but only while
                                 the chip is unselected. See COUNT_ON above. */ }
                            <span class={ () => COUNT + (tag() === row.tag ? COUNT_ON : COUNT_OFF) }>
                                { () => count(row.count) }
                            </span>
                        </Link>
                    </span>
                </For>
            </nav>
        </Show>

        { /* Shaped like the cards that are coming, rather than the word "Loading": the row
             heights are known, so the page can hold its layout instead of collapsing and
             pushing the footer up for a moment. Repeated by hand - see Skeleton. */ }
        { /* `loading()` is "nothing to show yet", not "fetching": a language switch refetches
             with the list still on screen, and replacing it with grey boxes for a round trip
             would be a worse answer than letting the cards change under the reader. */ }
        <Show when={ index.loading() }>
            <div class="flex flex-col gap-4" aria-hidden="true">
                <Skeleton class="h-28 w-full" />
                <Skeleton class="h-28 w-full" />
                <Skeleton class="h-28 w-full" />
            </div>
        </Show>

        { /* A failure is NOT an empty blog, and used to render as one - same box, same
             heading, only the hint line differing. A reader whose network dropped was told
             there was nothing to read. */ }
        <Show when={ () => failed }>
            <Banner tone="danger">{ t().blog.notFoundHint }</Banner>
        </Show>

        <Show when={ () => !failed && posts !== null && posts!.length === 0 }>
            <EmptyState title={ t().blog.empty } hint={ t().blog.emptyHint } />
        </Show>

        <Show when={ posts !== null && posts.length > 0 }>
            <ul class="flex flex-col gap-4">
                <For each={ posts ?? [] } key={ (post) => post.slug } let={ post }>
                    <li>
                        <Link
                            to={ `/blog/${ post.slug }` }
                            class="flex flex-col gap-2 border border-line-strong bg-surface p-5 transition-colors hover:border-accent"
                        >
                            <span class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                                { /* Card text may be in a language the reader is not using, so it
                                     needs `dir` to ORDER correctly - an English title ending in
                                     `?` inside a Persian line puts that mark at the wrong end
                                     without one.
                                     
                                     The isolate goes on an INNER `bdi`, not on the flex child
                                     itself: a flex child is blockified, and `dir` on a block sets
                                     `text-align` as well as the ordering - which would left-align
                                     this one English card inside a right-aligned Persian list.
                                     The outer span keeps the page's alignment; the bdi carries the
                                     language. The post page does the opposite on purpose: there
                                     the body IS the page, so the article takes its own direction
                                     outright. */ }
                                <span class="font-display text-lg font-bold tracking-tight text-ink">
                                    <bdi lang={ post.locale } dir={ directionOf(post.locale) }>{ post.title }</bdi>
                                </span>
                                { /* The date is a Latin numeric run inside a possibly mirrored
                                     line, so it carries its own isolate - `bdi` on the inner
                                     element, never on the block that holds the alignment. */ }
                                <bdi dir="ltr" class="font-mono text-xs text-faint">{ day(post.publishedAt) }</bdi>
                            </span>

                            <Show when={ post.summary !== '' }>
                                <span class="text-muted">
                                    <bdi lang={ post.locale } dir={ directionOf(post.locale) }>{ post.summary }</bdi>
                                </span>
                            </Show>

                            { /* Said on the card as well as on the post: a reader scanning a list
                                 of English titles in a Persian interface should know why. */ }
                            <Show when={ !post.translated }>
                                <span class="text-sm text-faint">{ t().blog.notTranslated }</span>
                            </Show>
                        </Link>
                    </li>
                </For>
            </ul>
        </Show>

        { /* Links, so a reader can open page two in a new tab and a crawler can follow it. */ }
        <Pagination page={ page() } pages={ pageCount } href={ at } />
    </section>
}
