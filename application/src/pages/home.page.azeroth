import { For } from 'azerothjs';

import { ArrowRight, Code2, Terminal, Zap } from 'lucide';

import { DOWNLOADS, RELEASES_URL } from '../lib/content/site';
import type { Download } from '../lib/content/site';

import AddChainButton from '../components/add-chain-button.component.azeroth';
import { brandIcon } from '../components/brand-icon';
import Button from '../components/button.component.azeroth';
import { icon } from '../components/icon';
import { platformIcon } from '../components/platform-icon';

import { useLocale } from '../stores/locale';

import ChainSection from '../sections/chain.section.azeroth';
import ExplorerSection from '../sections/explorer.section.azeroth';
import NetworkSection from '../sections/network.section.azeroth';
import SocialSection from '../sections/social.section.azeroth';
import TokenomicsSection from '../sections/tokenomics.section.azeroth';

export default component Home()
{
    const { t } = useLocale();

    const tile = (entry: Download): string =>
        'flex items-center gap-3 rounded-xl border px-4 py-3 text-start transition-colors '
        + (entry.url === null
            ? 'cursor-not-allowed border-line bg-transparent opacity-55'
            : 'border-line bg-surface hover:border-line-strong hover:bg-elevated');

    { /* One root element, not a fragment: a route component returns a single MountNode,
         so an array of sections fails to mount. */ }
    <div>
        <section class="glow relative overflow-hidden px-5 pb-24 pt-20 sm:pt-28">
            <div class="mx-auto max-w-3xl text-center">
                <h1 class="text-balance text-4xl font-bold leading-[1.1] tracking-tight text-ink sm:text-6xl">
                    { t().hero.headline }
                </h1>

                <p class="mx-auto mt-6 max-w-xl text-pretty text-base leading-relaxed text-muted sm:text-lg">
                    { t().hero.subhead }
                </p>

                <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
                    <Button href="#wallet" size="lg">
                        { t().hero.primaryCta }
                        { /* Flipped in Persian: this arrow means "onward", and onward is
                             leftward in RTL. The outbound arrow in the explorer card is
                             deliberately NOT flipped, because that one means "off-site". */ }
                        { icon(ArrowRight, 'size-[18px] rtl:rotate-180') }
                    </Button>

                    <Button href="#chain" size="lg" variant="secondary">
                        { t().hero.secondaryCta }
                    </Button>

                    <AddChainButton size="lg" />
                </div>
            </div>
        </section>

        { /* Directly under the hero, ahead of the download: the claims above are promises,
             and these are the only numbers on the page read off the live chain. Somebody
             deciding whether to install a wallet should meet the proof first. */ }
        <NetworkSection />

        <section id="wallet" class="border-t border-line px-5 py-20">
            { /* `max-w-4xl`, the same measure as every other section. It was 5xl, which
                 put this one block 64px wider on each side than the sections above and
                 below it - not obviously wrong on its own, but scrolling past it the left
                 edge of the page steps out and back again. Its grids were never using
                 the extra room for anything. */ }
            <div class="mx-auto max-w-4xl">
                <h2 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">{ t().wallet.title }</h2>
                <p class="mt-3 text-muted">{ t().wallet.subtitle }</p>

                <div class="mt-10 grid gap-3 sm:grid-cols-3">
                    <div class="rounded-2xl border border-line bg-surface p-5">
                        <span class="text-accent">{ icon(Code2) }</span>
                        <h3 class="mt-3 font-semibold text-ink">{ t().wallet.features.selfCustody }</h3>
                        <p class="mt-1.5 text-sm leading-relaxed text-muted">{ t().wallet.features.selfCustodyBody }</p>
                    </div>
                    <div class="rounded-2xl border border-line bg-surface p-5">
                        <span class="text-accent">{ icon(Zap) }</span>
                        <h3 class="mt-3 font-semibold text-ink">{ t().wallet.features.speed }</h3>
                        <p class="mt-1.5 text-sm leading-relaxed text-muted">{ t().wallet.features.speedBody }</p>
                    </div>
                    <div class="rounded-2xl border border-line bg-surface p-5">
                        <span class="text-accent">{ icon(Terminal) }</span>
                        <h3 class="mt-3 font-semibold text-ink">{ t().wallet.features.openSource }</h3>
                        <p class="mt-1.5 text-sm leading-relaxed text-muted">{ t().wallet.features.openSourceBody }</p>
                    </div>
                </div>

                <div class="mt-10 rounded-2xl border border-line bg-surface p-6">
                    <p class="text-sm font-medium text-faint">{ t().wallet.platforms }</p>

                    { /* Every platform on one footing. This used to promote whichever OS a
                         user-agent sniff guessed into a big accent button with the other five
                         demoted to tiles below - which made Windows look like the supported
                         platform and the rest like afterthoughts, and put the wrong one on top
                         whenever the guess missed. A uniform grid states what is true: six
                         targets, three of them shipping. */ }
                    <div class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
                        <For each={ () => [...DOWNLOADS] } key={ (entry) => entry.id } let={ entry }>
                            <a
                                href={ entry.url ?? undefined }
                                aria-disabled={ entry.url === null ? 'true' : 'false' }
                                class={ tile(entry) }
                            >
                                { /* Its own brand colour, but only while the row is live: a
                                     coming-soon tile is dimmed to 55% and a full-strength mark
                                     inside it would read as the one thing you CAN click. */ }
                                <span
                                    class="shrink-0 text-muted"
                                    style={ entry.url === null ? undefined : `color: var(--brand-${ entry.id })` }
                                >
                                    { platformIcon(entry.id) }
                                </span>
                                <span class="min-w-0">
                                    <span class="block text-sm font-medium text-ink">{ entry.label }</span>
                                    { /* The note is a Latin format string, so Persian needs it
                                         pinned LTR: bidi treats a leading "." as neutral and
                                         flips it to the far end, rendering ".deb · x64" as
                                         "deb · x64.". The dir goes on an INLINE wrapper, not on
                                         the block above - `text-start` resolves against each
                                         element's own direction, so an ltr block would align the
                                         note to the opposite edge from the label sitting over
                                         it. The coming-soon copy is translated and keeps the
                                         page direction. */ }
                                    <span class="block text-xs text-faint">
                                        <span dir={ entry.url === null ? undefined : 'ltr' }>
                                            { entry.url === null ? t().wallet.comingSoon : entry.note }
                                        </span>
                                    </span>
                                </span>
                            </a>
                        </For>
                    </div>

                    { /* The escape hatch for everything the six tiles above cannot say: arm64,
                         .rpm, .AppImage, the per-ABI APKs, and older versions. Each tile links
                         ONE mainstream build, so without this the other formats would simply
                         not exist as far as a visitor could tell. */ }
                    <a
                        href={ RELEASES_URL }
                        target="_blank"
                        rel="noreferrer noopener"
                        class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-muted underline-offset-4 transition-colors hover:text-ink hover:underline"
                    >
                        { brandIcon('github') }
                        { t().wallet.allDownloads }
                    </a>
                </div>
            </div>
        </section>

        <TokenomicsSection />
        <ChainSection />
        <ExplorerSection />
        <SocialSection />
    </div>
}
