import { For } from 'azerothjs';

import { Code2, Terminal, Zap } from 'lucide';

import { DOWNLOADS, NETWORK_NAME, RELEASES_URL, ROADMAP, SITE_URL } from '../lib/content/site';
import { HOME_DESCRIPTION, HOME_TITLE } from '../lib/content/page-copy';
import { organization, pageHead } from '../lib/head';
import { onReady, reveal, revealItems } from '../lib/motion';

import DownloadTile from '../components/chain/download-tile.component.azeroth';
import { brandIcon } from '../components/icons/brand-icon';
import { icon } from '../components/icons/icon';
import SectionHeading from '../components/layout/section-heading.component.azeroth';

import { useLocale } from '../stores/locale';

import ChainSection from '../sections/chain.section.azeroth';
import ExplorerSection from '../sections/explorer.section.azeroth';
import HeroSection from '../sections/hero.section.azeroth';
import RoadmapSection from '../sections/roadmap.section.azeroth';
import NetworkSection from '../sections/network.section.azeroth';
import SocialSection from '../sections/social.section.azeroth';
import TokenomicsSection from '../sections/tokenomics.section.azeroth';

export default component Home()
{
    const { t } = useLocale();

    /*
     * The site's own front door, and the one head that has to agree with `index.html`.
     *
     * The shell states the same title and description for every path a page does not own, and
     * for a reader with no JavaScript before this declaration is applied - so the two are the
     * same strings on purpose. `WebSite` and `Organization` are what a search engine reads to
     * name the site and its publisher; there is deliberately no `SearchAction`, because there
     * is no search box here and describing one is a promise a crawler acts on.
     */
    pageHead({
        title: () => HOME_TITLE,
        description: () => HOME_DESCRIPTION,
        path: '/',
        type: 'website',
        jsonLd: () => [
            {
                '@context': 'https://schema.org',
                '@type': 'WebSite',
                name: NETWORK_NAME,
                description: HOME_DESCRIPTION,
                url: `${ SITE_URL }/`,
                publisher: organization()
            },
            { '@context': 'https://schema.org', ...organization() }
        ]
    });

    // The wallet section rises once, when it first scrolls into view. reveal() holds the
    // reduced-motion and no-IntersectionObserver fallbacks; without JS nothing is hidden.
    // onReady waits for the section to exist because effects run before DOM attachment.
    effect
    {
        const releaseA = onReady('wallet', (section) => reveal(section, { heading: true }));
        const releaseB = onReady('wallet', (section) => revealItems(section, '#wallet-features'));
        const releaseC = onReady('wallet', (section) => revealItems(section, '#wallet-platforms'));

        cleanup
        {
            releaseA();
            releaseB();
            releaseC();
        }
    }

    { /* One root element, not a fragment: a route component returns a single MountNode,
         so an array of sections fails to mount. */ }
    <div>
        <HeroSection />

        { /* Directly under the hero, ahead of the download: the claims above are promises,
             and these are the only numbers on the page read off the live chain. Somebody
             deciding whether to install a wallet should meet the proof first. */ }
        <NetworkSection />

        { /* `pb-12` rather than a matching `py-20`: the last thing in here is a quiet text
             link to the releases page, not a block of content, and eighty pixels under a
             single line of 14px text read as the section having lost its footing. */ }
        <section id="wallet" class="border-t border-line px-5 pt-20 pb-12">
            { /* `max-w-4xl`, the same measure as every other section. It was 5xl, which
                 put this one block 64px wider on each side than the sections above and
                 below it - not obviously wrong on its own, but scrolling past it the left
                 edge of the page steps out and back again. Its grids were never using
                 the extra room for anything. */ }
            <div class="mx-auto max-w-4xl">
                <SectionHeading index="02" title={ t().wallet.title } subtitle={ t().wallet.subtitle } />

                <div id="wallet-features" class="mt-10 grid gap-3 sm:grid-cols-3">
                    <div class="border border-line bg-surface p-5 transition-colors hover:border-line-strong">
                        <span class="grid size-10 place-items-center border border-line-strong text-accent">{ icon(Code2, 'size-5') }</span>
                        <h3 class="mt-3 font-semibold text-ink">{ t().wallet.features.selfCustody }</h3>
                        <p class="mt-1.5 text-sm leading-relaxed text-muted">{ t().wallet.features.selfCustodyBody }</p>
                    </div>
                    <div class="border border-line bg-surface p-5 transition-colors hover:border-line-strong">
                        <span class="grid size-10 place-items-center border border-line-strong text-accent">{ icon(Zap, 'size-5') }</span>
                        <h3 class="mt-3 font-semibold text-ink">{ t().wallet.features.speed }</h3>
                        <p class="mt-1.5 text-sm leading-relaxed text-muted">{ t().wallet.features.speedBody }</p>
                    </div>
                    <div class="border border-line bg-surface p-5 transition-colors hover:border-line-strong">
                        <span class="grid size-10 place-items-center border border-line-strong text-accent">{ icon(Terminal, 'size-5') }</span>
                        <h3 class="mt-3 font-semibold text-ink">{ t().wallet.features.openSource }</h3>
                        <p class="mt-1.5 text-sm leading-relaxed text-muted">{ t().wallet.features.openSourceBody }</p>
                    </div>
                </div>

                <div class="mt-10 border border-line bg-surface p-6">
                    <p class="font-label text-[18px] font-medium uppercase tracking-[0.16em]">{ t().wallet.platforms }</p>

                    { /* Every platform on one footing. This used to promote whichever OS a
                         user-agent sniff guessed into a big accent button with the other five
                         demoted to tiles below - which made Windows look like the supported
                         platform and the rest like afterthoughts, and put the wrong one on top
                         whenever the guess missed. A uniform grid states what is true: seven
                         targets, five of them shipping. */ }
                    { /* A `<ul>`, and each row an `<li>` around the tile. Two reasons, and the
                         second is the compiler's: it IS a list of seven platforms, which is what
                         tells a screen reader how many there are before it reads the first; and
                         a `<For>` row must be exactly one host element, which `DownloadTile` is
                         not - it resolves to an `<a>` or a `<div>` depending on whether that
                         platform has a build yet, and a control-flow root compiles to a
                         fragment. The `<li>` is the row the reconciler moves. */ }
                    <ul id="wallet-platforms" class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
                        <For each={ () => [...DOWNLOADS] } key={ (entry) => entry.id } let={ entry }>
                            { /* `flex` so the tile inside stretches to the row's height: grid
                                 stretches the `<li>`, not its child. */ }
                            <li class="flex">
                                <DownloadTile entry={ entry } />
                            </li>
                        </For>
                    </ul>

                    { /* The escape hatch for everything the six tiles above cannot say: arm64,
                         .rpm, .AppImage, the per-ABI APKs, and older versions. Each tile links
                         ONE mainstream build, so without this the other formats would simply
                         not exist as far as a visitor could tell. */ }
                    <a
                        href={ RELEASES_URL }
                        target="_blank"
                        rel="noreferrer noopener"
                        class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-muted underline-offset-4 transition-colors hover:text-ink hover:underline"
                    >
                        { brandIcon('github') }
                        { t().wallet.allDownloads }
                    </a>
                </div>
            </div>
        </section>

        <TokenomicsSection />
        <ChainSection />
        { /* Between the chain facts and the explorer: somebody who has just read what the
             chain IS is the one asking what happens to it next.

             Off the page entirely while ROADMAP is empty, rather than rendering an empty
             section - a bordered strip with a heading and nothing under it is worse than no
             section at all.

             ITS INDEX IS "05", AND SO IS THE COMMUNITY SECTION'S. That is not a mistake
             while this is hidden - the numbers count what a reader actually sees, and the
             visible run today is 01-05 with community last. Putting a milestone in ROADMAP
             makes this section appear and the two collide: bump community to "06" in the
             same commit. The explorer between them carries no number at all - it is a card
             with its own heading rather than a numbered section. */ }
        <Show when={ () => ROADMAP.length > 0 }>
            <RoadmapSection />
        </Show>

        <ExplorerSection />
        <SocialSection />
    </div>
}
