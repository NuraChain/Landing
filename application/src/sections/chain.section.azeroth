import { For } from 'azerothjs';

import { CHAIN } from '../lib/content/site';
import { onReady, reveal, revealItems } from '../lib/motion';

import CopyField from '../components/chain/copy-field.component.azeroth';
import SectionHeading from '../components/layout/section-heading.component.azeroth';

import { useLocale } from '../stores/locale';

/**
 * The reference card people come back for: everything needed to add Nura Chain to a wallet by
 * hand. Values stay in Latin script and LTR in both locales - an RPC URL or a chain ID
 * reversed by bidi is not a cosmetic problem, it is a value someone pastes and loses
 * funds to, which is also why the provisional banner is loud rather than a footnote.
 */
export default component ChainSection()
{
    const { t } = useLocale();

    // The section entrance, once, on first scroll into view. Fallbacks live in lib/motion;
    // onReady waits for the section to exist because effects run before DOM attachment.
    effect
    {
        const releaseA = onReady('chain', (section) => reveal(section, { heading: true }));
        const releaseB = onReady('chain', (section) => revealItems(section, '#chain dl'));

        cleanup
        {
            releaseA();
            releaseB();
        }
    }

    <section id="chain" class="border-t border-line px-5 py-16 sm:py-20">
        <div class="mx-auto max-w-4xl">
            <SectionHeading index="04" title={ t().chain.title } subtitle={ t().chain.subtitle } />

            <dl class="mt-8 divide-y divide-line overflow-hidden border border-line-strong bg-surface">
                <For each={ () => [...CHAIN] } key={ (fact) => fact.key } let={ fact }>
                    { /* The value takes a line of its OWN below `sm:`.

                         Side by side, the label claims 8rem of a 390px screen and the value
                         is left with about 118px - enough to render `https://rpc.nu...` and
                         stop. Truncating a decorative string is fine; truncating the RPC
                         endpoint defeats the one thing this section exists to do, which is
                         let somebody add the chain by hand. `basis-full` puts it on the next
                         flex line at full width; from `sm:` there is room to sit inline. */ }
                    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 px-4 py-3.5 sm:px-5">
                        <dt class="min-w-32 text-sm text-muted">{ t().chain[fact.key] }</dt>

                        <dd class="flex min-w-0 basis-full items-center gap-2 sm:flex-1">
                            <CopyField
                                value={ fact.value }
                                copyable={ fact.copyable }
                                href={ fact.link === true ? fact.value : undefined }
                                copyLabel={ `${ t().chain.copy } ${ t().chain[fact.key] }` }
                                copiedLabel={ t().chain.copied }
                            />
                        </dd>
                    </div>
                </For>
            </dl>
        </div>
    </section>
}
