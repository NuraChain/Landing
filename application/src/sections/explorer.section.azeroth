import { ArrowUpRight, Blocks, Receipt, Wallet } from 'lucide';

import { EXPLORER_URL } from '../lib/content/site';
import { onReady, reveal, revealItems } from '../lib/motion';

import { icon } from '../components/icons/icon';

import { useLocale } from '../stores/locale';

/**
 * The outbound card for Nura Explorer. Deliberately a preview rather than an embed: an
 * iframe of a live explorer would drag a third-party bundle, its own theme and its own
 * failure modes into a page whose whole job is to load fast and send people to a download.
 */
export default component ExplorerSection()
{
    const { t } = useLocale();

    // The section entrance, once, on first scroll into view. Fallbacks live in lib/motion;
    // onReady waits for the section to exist because effects run before DOM attachment.
    effect
    {
        const releaseA = onReady('explorer', (section) => reveal(section, { heading: true }));
        const releaseB = onReady('explorer', (section) => revealItems(section, '#explorer .grid'));

        cleanup
        {
            releaseA();
            releaseB();
        }
    }

    <section id="explorer" class="border-t border-line px-5 py-16 sm:py-20">
        <div class="mx-auto max-w-4xl">
            <div data-sh class="overflow-hidden border border-line-strong bg-surface">
                <div class="p-6 sm:p-10">
                    <h2 class="sh-title font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">{ t().explorer.title }</h2>
                    <p class="mt-3 max-w-lg text-muted">{ t().explorer.subtitle }</p>

                    <div class="mt-8 grid gap-3 sm:grid-cols-3">
                        <div class="flex items-center gap-3 border border-line bg-bg px-4 py-3">
                            <span class="text-accent">{ icon(Blocks, 'size-[18px]') }</span>
                            <span class="font-label text-xs font-medium uppercase tracking-[0.12em] text-ink">{ t().chain.blockTime }</span>
                        </div>
                        <div class="flex items-center gap-3 border border-line bg-bg px-4 py-3">
                            <span class="text-accent">{ icon(Receipt, 'size-[18px]') }</span>
                            <span class="font-label text-xs font-medium uppercase tracking-[0.12em] text-ink">{ t().nav.explorer }</span>
                        </div>
                        <div class="flex items-center gap-3 border border-line bg-bg px-4 py-3">
                            <span class="text-accent">{ icon(Wallet, 'size-[18px]') }</span>
                            <span class="font-label text-xs font-medium uppercase tracking-[0.12em] text-ink">{ t().nav.wallet }</span>
                        </div>
                    </div>

                    <a
                        href={ EXPLORER_URL }
                        target="_blank"
                        rel="noreferrer noopener"
                        class="mt-8 inline-flex h-12 items-center gap-2 bg-accent px-6 font-semibold text-accent-ink transition-colors hover:bg-accent-hover"
                    >
                        { t().explorer.cta }
                        { /* Mirrored, not rotated. The glyph means "away from this page",
                             and the flex row already moved it to the opposite edge in RTL -
                             so an unmirrored up-RIGHT arrow sitting at the LEFT edge points
                             back into the label it trails. Flipping the x axis makes it an
                             up-LEFT arrow, which is the same "away" it always was. Rotating
                             180 degrees would instead give a DOWN-left arrow and read as a
                             download. */ }
                        { icon(ArrowUpRight, 'size-[18px] rtl:-scale-x-100') }
                    </a>
                </div>
            </div>
        </div>
    </section>
}
