import { For, Show } from 'azerothjs';

import { ArrowLeftRight, Blocks, CircleAlert, CircleDollarSign, ExternalLink, Lock } from 'lucide';

import { BRIDGE_HOLDER, BRIDGE_HOLDER_BSC_URL, EXPLORER_URL, SWAP_URL } from '../lib/content/site';
import { blockHeight, bridgeTvl, nuraPrice, totalTransactions } from '../lib/network';
import type { NuraPrice, Tvl } from '../lib/network';

import Card from '../components/ui/card.component.azeroth';
import SectionHeading from '../components/layout/section-heading.component.azeroth';
import { icon } from '../components/icons/icon';
import IconButton from '../components/ui/icon-button.component.azeroth';

import { useLocale } from '../stores/locale';

/**
 * What the chain is doing right now, as opposed to what it is configured to be (the chain
 * card below) or what it promises (tokenomics above).
 *
 * Each tile tracks its own source, because they fail apart: height and TVL come from the
 * RPC and resolve today; the transaction total comes from the explorer and cannot resolve
 * in any browser until it sends CORS headers; the price comes from our own server relaying
 * the swap. Sharing one loading flag would let a blocked tile hide the working ones.
 *
 * A note on the price tile, because this file used to argue against having one. The
 * objection was that the coin traded nowhere, so any price would have to be invented, and
 * that a fabricated figure on a project's own site is worse than no figure at all. That
 * objection has been ANSWERED rather than dropped: Nura Swap now runs an AMM pool holding
 * the coin, so there is a real quote from a real market, and it is the same number the swap
 * shows its own users. What has not gone away is how thin that market is - see the note the
 * tile carries, which exists so nobody reads a $700 pool as a valuation. The unrelated
 * "NURA" on CoinGecko is still Nura Labs, and is still not this coin.
 */
export default component NetworkSection()
{
    const { locale, t } = useLocale();

    state height = null as number | null;
    state heightFailed = false;

    state total = null as number | null;
    state totalFailed = false;

    // The whole breakdown, not just the total: the per-token split is already in the reply,
    // and throwing it away would mean a second round trip to show what arrived first time.
    state tvl = null as Tvl | null;
    state tvlFailed = false;
    state showParts = false;

    state price = null as NuraPrice | null;
    state priceFailed = false;
    state showPriceNote = false;

    const number = (value: number): string => new Intl.NumberFormat(locale()).format(value);

    /**
     * Cents below a thousand dollars, none above it. A TVL of $4,182,905.31 does not need
     * its cents, but $0 and $12.40 read as broken without them.
     */
    const money = (value: number): string => new Intl.NumberFormat(locale(), {
        style: 'currency',
        currency: 'USD',
        maximumFractionDigits: value >= 1000 ? 0 : 2
    }).format(value);

    /**
     * Token amounts, which are not money and must not be rounded like it: a bridge holding
     * 0.004 BNB is holding something, and `maximumFractionDigits: 2` would render it as
     * zero. Six digits is where 18-decimal dust stops being worth a line in a summary.
     */
    const amount = (value: number): string =>
        new Intl.NumberFormat(locale(), { maximumFractionDigits: 6 }).format(value);

    /**
     * A price, which needs a different rule from either of the two above.
     *
     * `money` cannot do this job: NURA trades far below a cent, and two fraction digits
     * render every possible price of it as "$0.00". Significant digits instead, so a
     * sub-cent figure keeps its meaning - but ONLY below a dollar, because significant
     * digits applied to $1,234.50 round it to "$1,235" and eat the cents that `money`
     * exists to keep. One rule each side of the boundary, and the boundary is where the
     * two disagree.
     */
    const usd = (value: number): string => new Intl.NumberFormat(locale(), {
        style: 'currency',
        currency: 'USD',
        ...(value < 1 ? { maximumSignificantDigits: 4 } : { maximumFractionDigits: 2 })
    }).format(value);

    /** Clock time, for the "last read" line. The date is never in question - it is today. */
    const clock = (value: Date): string =>
        new Intl.DateTimeFormat(locale(), { hour: '2-digit', minute: '2-digit' }).format(value);

    /**
     * An em-dash once a read has failed, an ellipsis while the first one is still out. The
     * two read differently on purpose: "we asked and got nothing" is not "we have not asked
     * yet", and a reader watching a stuck ellipsis deserves to learn which it is.
     */
    const figure = (
        value: number | null,
        failed: boolean,
        format: (value: number) => string = number
    ): string => value === null ? (failed ? '—' : '…') : format(value);

    // Once on mount, then once a minute. The minute here and the minute in the cache are
    // the same minute by design: a tick landing inside the window is served from memory, so
    // several readers on one page still cost one request per source per minute.
    effect
    {
        let live = true;

        const load = (): void =>
        {
            blockHeight()
                .then((value) =>
                {
                    if (live)
                    {
                        height = value;
                        heightFailed = false;
                    }
                })
                .catch(() =>
                {
                    // A later failure keeps the last good figure on screen rather than
                    // blanking it: a minute-old height beats an em-dash.
                    if (live)
                    {
                        heightFailed = true;
                    }
                });

            totalTransactions()
                .then((value) =>
                {
                    if (live)
                    {
                        total = value;
                        totalFailed = false;
                    }
                })
                .catch(() =>
                {
                    if (live)
                    {
                        totalFailed = true;
                    }
                });

            bridgeTvl()
                .then((value) =>
                {
                    if (live)
                    {
                        tvl = value;
                        tvlFailed = false;
                    }
                })
                .catch(() =>
                {
                    if (live)
                    {
                        tvlFailed = true;
                    }
                });

            nuraPrice()
                .then((value) =>
                {
                    if (live)
                    {
                        price = value;
                        priceFailed = false;
                    }
                })
                .catch(() =>
                {
                    if (live)
                    {
                        priceFailed = true;
                    }
                });
        };

        load();

        const timer = window.setInterval(load, 60_000);

        cleanup
        {
            live = false;
            window.clearInterval(timer);
        }
    }

    // Escape closes whichever panel is open, the same contract the drawer, the language modal
    // and the tokenomics notes all keep. It matters more here than it did under hover: a panel
    // that only opens on click is a panel that stays open until something closes it.
    //
    // One listener for both panels rather than one each. Two would race on a shared key: with
    // both open, whichever bound last would still only close its own, and the other would need
    // a second Escape to go - which is not what a reader pressing it means.
    effect
    {
        if (!showParts && !showPriceNote)
        {
            return;
        }

        const onKey = (event: KeyboardEvent): void =>
        {
            if (event.key === 'Escape')
            {
                showParts = false;
                showPriceNote = false;
            }
        };

        document.addEventListener('keydown', onKey);

        cleanup
        {
            document.removeEventListener('keydown', onKey);
        }
    }

    // The section entrance, once, on first scroll into view. Fallbacks live in lib/motion;
    // onReady waits for the section to exist because effects run before DOM attachment.
    // The heading draws its rule; the three tiles stagger in with a spring each.
    effect
    {
        const releaseA = onReady('network', (section) => reveal(section, { heading: true }));
        const releaseB = onReady('network', (section) => revealItems(section, '#network .grid'));

        cleanup
        {
            releaseA();
            releaseB();
        }
    }

    <section id="network" class="border-t border-line px-5 py-16 sm:py-20">
        <div class="mx-auto max-w-4xl">
            <SectionHeading index="01" title={ t().network.title } subtitle={ t().network.subtitle } />

            { /* Four across on a wide screen, two-by-two below it. Not three-and-an-orphan:
                 the tiles are peers reading four separate sources, and a row of one reads as
                 an afterthought rather than as the fourth of four. */ }
            <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                { /* The figure a visitor came for, so it leads. Also the only tile whose
                     source is a MARKET rather than a ledger - hence the note, which is not
                     optional garnish: the pool behind this quote holds a few hundred dollars,
                     and a number that small moves on a single trade. Stating the price
                     without stating that would be the same failure as inventing one. */ }
                <Card class="relative">
                    <p class="flex items-center gap-2 text-sm text-muted">
                        { icon(CircleDollarSign, 'size-4 shrink-0') }
                        { t().network.price }

                        <IconButton
                            label={ t().network.priceNote }
                            size="sm"
                            tone="faint"
                            pad
                            expanded={ showPriceNote }
                            class="ms-auto"
                            onClick={ () => showPriceNote = !showPriceNote }
                        >
                            { icon(CircleAlert, 'size-4') }
                        </IconButton>
                    </p>
                    <p class="mt-1 font-mono text-2xl font-semibold text-ink sm:text-3xl lg:text-2xl">
                        { () => figure(price === null ? null : price.usd, priceFailed, usd) }
                    </p>

                    { /* Same construction as the TVL breakdown below: in the DOM once loaded
                         so the caveat reaches a screen reader whichever way the panel sits,
                         absolute so opening it cannot shove its neighbours, and inert while
                         closed so an invisible box never eats a click. */ }
                    <Show when={ () => price !== null }>
                        <div
                            class={ () => 'absolute inset-x-0 top-full z-20 pt-2 '
                                + (showPriceNote ? '' : 'pointer-events-none') }
                        >
                            <div
                                class={ () => 'rounded-xl border border-line bg-elevated p-3 shadow-2xl'
                                    + ' transition-opacity duration-150 '
                                    + (showPriceNote ? 'opacity-100' : 'opacity-0') }
                            >
                                <p class="text-xs leading-relaxed text-muted">{ t().network.priceThin }</p>

                                <div class="mt-2 space-y-1 border-t border-line pt-2">
                                    { /* Makes the figure checkable rather than asserted, the
                                         same way the TVL breakdown links its holder: this is
                                         the page the number was read from. */ }
                                    <a
                                        href={ SWAP_URL }
                                        target="_blank"
                                        rel="noreferrer noopener"
                                        class="flex items-center justify-between gap-4 text-xs text-muted transition-colors hover:text-ink"
                                    >
                                        <span>{ t().network.priceSource }</span>
                                        <span class="flex items-center gap-1" dir="ltr">
                                            Nura Swap
                                            { icon(ExternalLink, 'size-3 shrink-0') }
                                        </span>
                                    </a>

                                    { /* The server keeps answering with its last good reading
                                         for a quarter of an hour after the swap goes quiet, so
                                         "now" is not a safe assumption to let a reader make.
                                         This is the only place that age is visible. */ }
                                    <p class="flex items-center justify-between gap-4 text-xs text-muted">
                                        <span>{ t().network.priceAsOf }</span>
                                        <span class="font-mono">
                                            { () => price === null ? '' : clock(price.at) }
                                        </span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </Show>
                </Card>

                <Card>
                    <p class="flex items-center gap-2 text-sm text-muted">
                        { icon(Blocks, 'size-4 shrink-0') }
                        { t().network.blockHeight }
                    </p>
                    <p class="mt-1 font-mono text-2xl font-semibold text-ink sm:text-3xl">
                        { () => figure(height, heightFailed) }
                    </p>
                </Card>

                <Card shape="square">
                    <p class="flex items-center gap-2 font-label text-[11px] uppercase tracking-[0.14em] text-faint">
                        { icon(ArrowLeftRight, 'size-4 shrink-0') }
                        { t().network.transactions }
                    </p>
                    <p class="mt-1 font-mono text-2xl font-semibold text-ink sm:text-3xl">
                        { () => figure(total, totalFailed) }
                    </p>
                </Card>

                { /* The only tile that is a SUM, so it is the only one that owes a
                     breakdown: "$0.00" is a fact about two balances, and a reader who
                     wants to know which asset is empty should not have to open a block
                     explorer to find out. */ }
                <Card shape="square" class="relative">
                    <p class="flex items-center gap-2 font-label text-[11px] uppercase tracking-[0.14em] text-faint">
                        { icon(Lock, 'size-4 shrink-0') }
                        { t().network.tvl }

                        { /* The one and only way in. Hover opened this until now, which
                             meant the panel could not be reached without a pointer and
                             appeared for anyone whose cursor merely crossed the tile. A
                             button is the honest control: it works by click, by Enter, by
                             tap, and it says whether it is open. */ }
                        { /* `pad` widens the hit area to 44px without moving the row, which
                             styles.css otherwise forbids per component - so the exception is
                             written down. The global rule inflates controls under a COARSE
                             pointer, and this button is 24px, which is the floor for a mouse
                             and no more. Safe here only because it sits alone at the end of
                             its line; the six allocation toggles in the tokenomics section do
                             NOT get it. */ }
                        <IconButton
                            label={ t().network.breakdown }
                            size="sm"
                            tone="faint"
                            pad
                            expanded={ showParts }
                            class="ms-auto"
                            onClick={ () => showParts = !showParts }
                        >
                            { icon(CircleAlert, 'size-4') }
                        </IconButton>
                    </p>
                    <p class="mt-1 font-mono text-2xl font-semibold text-ink sm:text-3xl">
                        { () => figure(tvl === null ? null : tvl.usd, tvlFailed, money) }
                    </p>

                    { /* Stays in the DOM once loaded and hides with opacity rather than
                         `Show`, so the amounts reach a screen reader whether or not the
                         panel is open. Absolute, so opening it cannot shove the
                         neighbouring tiles around, and `pointer-events-none` while closed
                         so an invisible box never swallows a click meant for the page. */ }
                    <Show when={ () => tvl !== null }>
                        <div
                            class={ () => 'absolute inset-x-0 top-full z-20 pt-2 '
                                + (showParts ? '' : 'pointer-events-none') }
                        >
                            <div
                                class={ () => 'border border-line bg-elevated p-3 shadow-2xl'
                                    + ' transition-opacity duration-150 '
                                    + (showParts ? 'opacity-100' : 'opacity-0') }
                            >
                                <For each={ () => tvl === null ? [] : [...tvl.parts] } key={ (part) => part.symbol } let={ part }>
                                    <div class="flex items-baseline justify-between gap-4 py-0.5">
                                        <span class="text-sm text-muted">{ part.symbol }</span>
                                        <span class="font-mono text-sm text-ink" dir="ltr">
                                            { () => amount(part.units) }
                                        </span>
                                    </div>
                                </For>

                                { /* Makes the total checkable instead of asserted: the same
                                     account on both sides of the bridge. Nura is where the
                                     tokens counted above actually sit; BNB Chain is where
                                     the collateral behind them would be. Chain names label
                                     the rows because both links point at one address, and
                                     without the chain the pair reads as a duplicate. */ }
                                <div class="mt-2 space-y-1 border-t border-line pt-2">
                                    <a
                                        href={ `${ EXPLORER_URL }/address/${ BRIDGE_HOLDER }` }
                                        target="_blank"
                                        rel="noreferrer noopener"
                                        class="flex items-center justify-between gap-4 text-xs text-muted transition-colors hover:text-ink"
                                    >
                                        <span>{ t().network.holder }</span>
                                        <span class="flex items-center gap-1 font-mono" dir="ltr">
                                            { `${ BRIDGE_HOLDER.slice(0, 6) }…${ BRIDGE_HOLDER.slice(-4) }` }
                                            { icon(ExternalLink, 'size-3 shrink-0') }
                                        </span>
                                    </a>

                                    <a
                                        href={ BRIDGE_HOLDER_BSC_URL }
                                        target="_blank"
                                        rel="noreferrer noopener"
                                        class="flex items-center justify-between gap-4 text-xs text-muted transition-colors hover:text-ink"
                                    >
                                        <span dir="ltr">BNB · BscScan</span>
                                        <span class="flex items-center gap-1 font-mono" dir="ltr">
                                            { `${ BRIDGE_HOLDER.slice(0, 6) }…${ BRIDGE_HOLDER.slice(-4) }` }
                                            { icon(ExternalLink, 'size-3 shrink-0') }
                                        </span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </Show>
                </Card>
            </div>

            { /* Only for a tile that has never loaded. A failed REFRESH stays silent,
                 because the figure on screen is still the one this section promised. */ }
            <Show when={ () => (heightFailed && height === null)
                || (totalFailed && total === null)
                || (tvlFailed && tvl === null)
                || (priceFailed && price === null) }>
                <p class="mt-3 text-sm text-faint">{ t().network.unavailable }</p>
            </Show>
        </div>
    </section>
}
