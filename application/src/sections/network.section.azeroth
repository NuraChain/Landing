import { For, Show } from 'azerothjs';

import { ArrowLeftRight, Blocks, CircleAlert, ExternalLink, Lock } from 'lucide';

import { BRIDGE_HOLDER, BRIDGE_HOLDER_BSC_URL, EXPLORER_URL } from '../lib/content/site';
import { blockHeight, bridgeTvl, totalTransactions } from '../lib/network';
import type { Tvl } from '../lib/network';

import Card from '../components/ui/card.component.azeroth';
import SectionHeading from '../components/layout/section-heading.component.azeroth';
import { icon } from '../components/icons/icon';
import IconButton from '../components/ui/icon-button.component.azeroth';

import { useLocale } from '../stores/locale';

/**
 * What the chain is doing right now, as opposed to what it is configured to be (the chain
 * card below) or what it promises (tokenomics above).
 *
 * Only two figures, because only two are real. Price and TVL have no source: no exchange
 * lists the coin and DefiLlama tracks no Nura chain, and the one "NURA" on CoinGecko is an
 * unrelated project called Nura Labs. A tile showing THAT number would be worse than no
 * tile - somebody reads a price off a project's own site and believes it.
 *
 * Each tile tracks its own source, because they fail apart: height and TVL come from the
 * RPC and resolve today, while the transaction total comes from the explorer and cannot
 * resolve in any browser until it sends CORS headers. Sharing one loading flag would let
 * the blocked tile hide the working ones.
 *
 * Price is still absent as a tile of its own, and deliberately: TVL prices BRIDGED assets,
 * whose markets exist. The coin itself trades nowhere, so a NURA price would have to be
 * invented.
 */
export default component NetworkSection()
{
    const { locale, t } = useLocale();

    state height = null as number | null;
    state heightFailed = false;

    state total = null as number | null;
    state totalFailed = false;

    // The whole breakdown, not just the total: the per-token split is already in the reply,
    // and throwing it away would mean a second round trip to show what arrived first time.
    state tvl = null as Tvl | null;
    state tvlFailed = false;
    state showParts = false;

    const number = (value: number): string => new Intl.NumberFormat(locale()).format(value);

    /**
     * Cents below a thousand dollars, none above it. A TVL of $4,182,905.31 does not need
     * its cents, but $0 and $12.40 read as broken without them.
     */
    const money = (value: number): string => new Intl.NumberFormat(locale(), {
        style: 'currency',
        currency: 'USD',
        maximumFractionDigits: value >= 1000 ? 0 : 2
    }).format(value);

    /**
     * Token amounts, which are not money and must not be rounded like it: a bridge holding
     * 0.004 BNB is holding something, and `maximumFractionDigits: 2` would render it as
     * zero. Six digits is where 18-decimal dust stops being worth a line in a summary.
     */
    const amount = (value: number): string =>
        new Intl.NumberFormat(locale(), { maximumFractionDigits: 6 }).format(value);

    /**
     * An em-dash once a read has failed, an ellipsis while the first one is still out. The
     * two read differently on purpose: "we asked and got nothing" is not "we have not asked
     * yet", and a reader watching a stuck ellipsis deserves to learn which it is.
     */
    const figure = (
        value: number | null,
        failed: boolean,
        format: (value: number) => string = number
    ): string => value === null ? (failed ? '—' : '…') : format(value);

    // Once on mount, then once a minute. The minute here and the minute in the cache are
    // the same minute by design: a tick landing inside the window is served from memory, so
    // several readers on one page still cost one request per source per minute.
    effect
    {
        let live = true;

        const load = (): void =>
        {
            blockHeight()
                .then((value) =>
                {
                    if (live)
                    {
                        height = value;
                        heightFailed = false;
                    }
                })
                .catch(() =>
                {
                    // A later failure keeps the last good figure on screen rather than
                    // blanking it: a minute-old height beats an em-dash.
                    if (live)
                    {
                        heightFailed = true;
                    }
                });

            totalTransactions()
                .then((value) =>
                {
                    if (live)
                    {
                        total = value;
                        totalFailed = false;
                    }
                })
                .catch(() =>
                {
                    if (live)
                    {
                        totalFailed = true;
                    }
                });

            bridgeTvl()
                .then((value) =>
                {
                    if (live)
                    {
                        tvl = value;
                        tvlFailed = false;
                    }
                })
                .catch(() =>
                {
                    if (live)
                    {
                        tvlFailed = true;
                    }
                });
        };

        load();

        const timer = window.setInterval(load, 60_000);

        cleanup
        {
            live = false;
            window.clearInterval(timer);
        }
    }

    // Escape closes the breakdown, the same contract the drawer, the language modal and the
    // tokenomics notes all keep. It matters more here than it did under hover: a panel that
    // only opens on click is a panel that stays open until something closes it.
    effect
    {
        if (!showParts)
        {
            return;
        }

        const onKey = (event: KeyboardEvent): void =>
        {
            if (event.key === 'Escape')
            {
                showParts = false;
            }
        };

        document.addEventListener('keydown', onKey);

        cleanup
        {
            document.removeEventListener('keydown', onKey);
        }
    }

    <section id="network" class="border-t border-line px-5 py-16 sm:py-20">
        <div class="mx-auto max-w-4xl">
            <SectionHeading title={ t().network.title } subtitle={ t().network.subtitle } />

            <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                <Card>
                    <p class="flex items-center gap-2 text-sm text-muted">
                        { icon(Blocks, 'size-4 shrink-0') }
                        { t().network.blockHeight }
                    </p>
                    <p class="mt-1 font-mono text-2xl font-semibold text-ink sm:text-3xl">
                        { () => figure(height, heightFailed) }
                    </p>
                </Card>

                <Card>
                    <p class="flex items-center gap-2 text-sm text-muted">
                        { icon(ArrowLeftRight, 'size-4 shrink-0') }
                        { t().network.transactions }
                    </p>
                    <p class="mt-1 font-mono text-2xl font-semibold text-ink sm:text-3xl">
                        { () => figure(total, totalFailed) }
                    </p>
                </Card>

                { /* The only tile that is a SUM, so it is the only one that owes a
                     breakdown: "$0.00" is a fact about two balances, and a reader who
                     wants to know which asset is empty should not have to open a block
                     explorer to find out. */ }
                <Card class="relative">
                    <p class="flex items-center gap-2 text-sm text-muted">
                        { icon(Lock, 'size-4 shrink-0') }
                        { t().network.tvl }

                        { /* The one and only way in. Hover opened this until now, which
                             meant the panel could not be reached without a pointer and
                             appeared for anyone whose cursor merely crossed the tile. A
                             button is the honest control: it works by click, by Enter, by
                             tap, and it says whether it is open. */ }
                        { /* `pad` widens the hit area to 44px without moving the row, which
                             styles.css otherwise forbids per component - so the exception is
                             written down. The global rule inflates controls under a COARSE
                             pointer, and this button is 24px, which is the floor for a mouse
                             and no more. Safe here only because it sits alone at the end of
                             its line; the six allocation toggles in the tokenomics section do
                             NOT get it. */ }
                        <IconButton
                            label={ t().network.breakdown }
                            size="sm"
                            tone="faint"
                            pad
                            expanded={ showParts }
                            class="ms-auto"
                            onClick={ () => showParts = !showParts }
                        >
                            { icon(CircleAlert, 'size-4') }
                        </IconButton>
                    </p>
                    <p class="mt-1 font-mono text-2xl font-semibold text-ink sm:text-3xl">
                        { () => figure(tvl === null ? null : tvl.usd, tvlFailed, money) }
                    </p>

                    { /* Stays in the DOM once loaded and hides with opacity rather than
                         `Show`, so the amounts reach a screen reader whether or not the
                         panel is open. Absolute, so opening it cannot shove the
                         neighbouring tiles around, and `pointer-events-none` while closed
                         so an invisible box never swallows a click meant for the page. */ }
                    <Show when={ () => tvl !== null }>
                        <div
                            class={ () => 'absolute inset-x-0 top-full z-20 pt-2 '
                                + (showParts ? '' : 'pointer-events-none') }
                        >
                            <div
                                class={ () => 'rounded-xl border border-line bg-elevated p-3 shadow-2xl'
                                    + ' transition-opacity duration-150 '
                                    + (showParts ? 'opacity-100' : 'opacity-0') }
                            >
                                <For each={ () => tvl === null ? [] : [...tvl.parts] } key={ (part) => part.symbol } let={ part }>
                                    <div class="flex items-baseline justify-between gap-4 py-0.5">
                                        <span class="text-sm text-muted">{ part.symbol }</span>
                                        <span class="font-mono text-sm text-ink" dir="ltr">
                                            { () => amount(part.units) }
                                        </span>
                                    </div>
                                </For>

                                { /* Makes the total checkable instead of asserted: the same
                                     account on both sides of the bridge. Nura is where the
                                     tokens counted above actually sit; BNB Chain is where
                                     the collateral behind them would be. Chain names label
                                     the rows because both links point at one address, and
                                     without the chain the pair reads as a duplicate. */ }
                                <div class="mt-2 space-y-1 border-t border-line pt-2">
                                    <a
                                        href={ `${ EXPLORER_URL }/address/${ BRIDGE_HOLDER }` }
                                        target="_blank"
                                        rel="noreferrer noopener"
                                        class="flex items-center justify-between gap-4 text-xs text-muted transition-colors hover:text-ink"
                                    >
                                        <span>{ t().network.holder }</span>
                                        <span class="flex items-center gap-1 font-mono" dir="ltr">
                                            { `${ BRIDGE_HOLDER.slice(0, 6) }…${ BRIDGE_HOLDER.slice(-4) }` }
                                            { icon(ExternalLink, 'size-3 shrink-0') }
                                        </span>
                                    </a>

                                    <a
                                        href={ BRIDGE_HOLDER_BSC_URL }
                                        target="_blank"
                                        rel="noreferrer noopener"
                                        class="flex items-center justify-between gap-4 text-xs text-muted transition-colors hover:text-ink"
                                    >
                                        <span dir="ltr">BNB · BscScan</span>
                                        <span class="flex items-center gap-1 font-mono" dir="ltr">
                                            { `${ BRIDGE_HOLDER.slice(0, 6) }…${ BRIDGE_HOLDER.slice(-4) }` }
                                            { icon(ExternalLink, 'size-3 shrink-0') }
                                        </span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </Show>
                </Card>
            </div>

            { /* Only for a tile that has never loaded. A failed REFRESH stays silent,
                 because the figure on screen is still the one this section promised. */ }
            <Show when={ () => (heightFailed && height === null)
                || (totalFailed && total === null)
                || (tvlFailed && tvl === null) }>
                <p class="mt-3 text-sm text-faint">{ t().network.unavailable }</p>
            </Show>
        </div>
    </section>
}
