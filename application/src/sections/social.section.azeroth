import { For } from 'azerothjs';

import { ArrowUpRight } from 'lucide';

import { SOCIALS } from '../lib/content/site';

import { brandIcon } from '../components/icons/brand-icon';
import Card from '../components/ui/card.component.azeroth';
import { icon } from '../components/icons/icon';
import SectionHeading from '../components/layout/section-heading.component.azeroth';

import { useLocale } from '../stores/locale';

export default component SocialSection()
{
    const { t } = useLocale();

    <section id="social" class="border-t border-line px-5 py-16 sm:py-20">
        <div class="mx-auto max-w-4xl">
            <SectionHeading title={ t().social.title } subtitle={ t().social.subtitle } />

            <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                <For each={ () => [...SOCIALS] } key={ (social) => social.id } let={ social }>
                    <div class="contents">
                        <Card href={ social.url } external padding="sm" class="group flex items-center gap-3">
                            <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-accent-soft text-accent">
                                { brandIcon(social.id) }
                            </span>

                            <span class="min-w-0 flex-1 truncate font-medium text-ink">{ social.label }</span>

                            { /* Mirrored in RTL for the same reason as the explorer CTA:
                                 the card's flex row parks this at the inline-end edge, which
                                 is the LEFT in Persian, and an up-right arrow there points
                                 back at the label instead of out of the card. */ }
                            <span class="shrink-0 text-faint transition-colors group-hover:text-ink">
                                { icon(ArrowUpRight, 'size-4 rtl:-scale-x-100') }
                            </span>
                        </Card>
                    </div>
                </For>
            </div>
        </div>
    </section>
}
