import { For, Show } from 'azerothjs';

import { Info } from 'lucide';

import { ALLOCATIONS, NATIVE_TOKEN_SYMBOL, SUPPLY } from '../lib/content/site';
import { onReady, reveal, revealItems } from '../lib/motion';

import Card from '../components/ui/card.component.azeroth';
import SectionHeading from '../components/layout/section-heading.component.azeroth';
import { icon } from '../components/icons/icon';

import IconButton from '../components/ui/icon-button.component.azeroth';

import { useLocale } from '../stores/locale';

/**
 * Categorical hues, validated rather than chosen by eye.
 *
 * The first attempt paired a blue and a violet that measured ΔE 0.3 under protanopia and
 * 8.7 with full colour vision: two segments nobody could tell apart. These are re-stepped
 * so the worst ADJACENT pair is ΔE 13.9 protan / 16.8 normal / 12.2 tritan, with similar
 * hues kept non-adjacent. Fixed order, never cycled: a slot belongs to an entity, so
 * adding or removing a row must not repaint the survivors - which is why the green was
 * APPENDED for the sixth allocation rather than slotted in where it looked best.
 *
 * Validated on adjacent pairs against all three theme surfaces, not chosen by eye. The
 * pairing only holds for THIS order; see the note on ALLOCATIONS before reordering. Teal
 * measures 2.94:1 on the white surface, under the 3:1 floor - the direct labels below are
 * what make that legal, so they are not optional decoration.
 */
const HUES: string[] = ['#22a89b', '#c07f26', '#6b8afd', '#e15a7c', '#a274d6', '#4f9e52'];

export default component TokenomicsSection()
{
    const { locale, t } = useLocale();

    state active = null as string | null;
    state openNote = null as string | null;

    // Locale-aware grouping, so Persian gets Persian digits and separators for free.
    const number = (value: number): string => new Intl.NumberFormat(locale()).format(value);
    const percent = (value: number): string =>
        new Intl.NumberFormat(locale(), { style: 'percent', maximumFractionDigits: 1 }).format(value / 100);

    /**
     * Tokens an allocation stands for: percent of the one real supply figure in site.ts.
     * Rounded to whole tokens - an allocation share is a policy, not an exact transfer,
     * so decimals past the integer are false precision.
     */
    const amount = (percentValue: number): string =>
        number(Math.round(SUPPLY.total * percentValue / 100));

    /**
     * `notes` is a separate table from `allocations`, so this returns undefined for any row
     * whose terms are not settled and that row renders no button at all. Every allocation
     * has a note today, but the lookup stays partial on purpose - it is what let the public
     * sale ship silent until its price was fixed, rather than carrying invented terms. The
     * cast is the honest way to index a deliberately partial record.
     */
    const noteFor = (key: string): string | undefined =>
        (t().tokenomics.notes as Record<string, string | undefined>)[key];

    // Escape closes the open note, matching the drawer and the language modal in the header.
    effect
    {
        if (openNote === null)
        {
            return;
        }

        const onKey = (event: KeyboardEvent): void =>
        {
            if (event.key === 'Escape')
            {
                openNote = null;
            }
        };

        document.addEventListener('keydown', onKey);

        cleanup
        {
            document.removeEventListener('keydown', onKey);
        }
    }

    // The section entrance, once, on first scroll into view. Fallbacks live in lib/motion;
    // onReady waits for the section to exist because effects run before DOM attachment.
    effect
    {
        const releaseA = onReady('tokenomics', (section) => reveal(section, { heading: true }));
        const releaseB = onReady('tokenomics', (section) => revealItems(section, '#tokenomics div.grid'));

        cleanup
        {
            releaseA();
            releaseB();
        }
    }

    <section id="tokenomics" class="border-t border-line px-5 py-16 sm:py-20">
        <div class="mx-auto max-w-4xl">
            <SectionHeading index="03" title={ t().tokenomics.title } subtitle={ t().tokenomics.subtitle } />

            { /* Two headline figures. A number this important is read, not decoded off an
                 axis, so it is a stat tile rather than another mark on the chart. */ }
            <div class="mt-8 grid gap-3 sm:grid-cols-2">
                <Card shape="square">
                    <p class="font-label text-[11px] uppercase tracking-[0.14em] text-faint">{ t().tokenomics.totalSupply }</p>
                    <p class="mt-1 font-mono text-2xl font-semibold text-ink sm:text-3xl">
                        { () => number(SUPPLY.total) }
                    </p>
                </Card>
                <Card shape="square">
                    <p class="font-label text-[11px] uppercase tracking-[0.14em] text-faint">{ t().tokenomics.circulating }</p>
                    <p class="mt-1 font-mono text-2xl font-semibold text-ink sm:text-3xl">
                        { () => number(SUPPLY.circulating) }
                    </p>
                </Card>
            </div>

            <h3 class="mt-10 font-label text-xs font-semibold uppercase tracking-[0.16em] text-faint">{ t().tokenomics.allocation }</h3>

            { /* A segmented bar, not a donut: this is parts-of-a-whole across 6 categories,
                 where comparing segment LENGTHS along one axis is the thing a reader
                 actually does. Angles are harder to compare than lengths. The 2px surface
                 gap between fills is what keeps two adjacent segments from reading as one.

                 Each segment answers to a hover the same way the legend row does - the
                 active one stays full-strength while the rest dim - and carries the token
                 amount in its title tooltip, so the bar itself can be read at the
                 segment, not only down in the legend. */ }
            <div
                class="mt-3 flex h-11 w-full gap-[2px] overflow-hidden"
                role="img"
                aria-label={ () => ALLOCATIONS
                    .map((a) => `${ t().tokenomics.allocations[a.key] } ${ percent(a.percent) } `
                        + `(${ amount(a.percent) } ${ NATIVE_TOKEN_SYMBOL })`)
                    .join(', ') }
            >
                <For each={ () => [...ALLOCATIONS] } key={ (slice) => slice.key } let={ slice } index={ index }>
                    <div
                        class="h-full transition-opacity duration-200"
                        style={ () => `flex: ${ slice.percent }; background: ${ HUES[index % HUES.length] };`
                            + (active === null || active === slice.key ? '' : 'opacity: 0.35;') }
                        title={ () => `${ t().tokenomics.allocations[slice.key] }: ${ percent(slice.percent) } · ${ amount(slice.percent) } ${ NATIVE_TOKEN_SYMBOL }` }
                        onMouseEnter={ () => active = slice.key }
                        onMouseLeave={ () => active = null }
                    ></div>
                </For>
            </div>

            { /* Every segment is direct-labelled here, which is what lets the palette sit
                 at its measured separation safely: identity never rests on colour alone.

                 The terms behind a slice open in place rather than floating in a tooltip:
                 they run to a full paragraph, and a hover tooltip that long has nowhere to
                 go on a phone and never opens at all without a mouse. A disclosure reads
                 the same on every input, so the expanded cell simply grows its grid row. */ }
            <ul class="mt-5 grid gap-x-6 gap-y-1 sm:grid-cols-2">
                <For each={ () => [...ALLOCATIONS] } key={ (slice) => slice.key } let={ slice } index={ index }>
                    <li
                        class="group transition-colors"
                        onMouseEnter={ () => active = slice.key }
                        onMouseLeave={ () => active = null }
                    >
                        <div class="flex items-center gap-2.5 px-1 py-1">
                            <span
                                class="size-3 shrink-0"
                                style={ `background: ${ HUES[index % HUES.length] }` }
                            ></span>
                            <span class="min-w-0 flex-1 truncate text-sm text-ink">
                                { () => t().tokenomics.allocations[slice.key] }
                            </span>
                            <span class="shrink-0 font-mono text-sm text-muted">{ () => percent(slice.percent) }</span>

                            { /* The token amount, revealed on hover: 25% is only a share,
                                 and the thing a reader actually wants off that number is
                                 how many tokens it is. Fades in beside the percent so the
                                 row reads in one glance. */ }
                            <span class="shrink-0 font-mono text-xs text-faint opacity-0 transition-opacity duration-150 group-hover:opacity-100">
                                { () => `${ amount(slice.percent) } ${ NATIVE_TOKEN_SYMBOL }` }
                            </span>

                            <Show when={ () => noteFor(slice.key) !== undefined }>
                                { /* No `pad`: these six sit 12px apart, and a widened hit area
                                     would have each one catching its neighbour's taps. */ }
                                <IconButton
                                    label={ `${ t().tokenomics.moreAbout } ${ t().tokenomics.allocations[slice.key] }` }
                                    size="sm"
                                    tone="faint"
                                    expanded={ openNote === slice.key }
                                    controls={ `allocation-note-${ slice.key }` }
                                    onClick={ () => openNote = openNote === slice.key ? null : slice.key }
                                >
                                    { icon(Info, 'size-4') }
                                </IconButton>
                            </Show>
                        </div>

                        <Show when={ () => openNote === slice.key }>
                            <p
                                id={ `allocation-note-${ slice.key }` }
                                class="mx-1 mb-1.5 bg-elevated px-3 py-2.5 text-sm leading-relaxed text-muted"
                            >
                                { () => noteFor(slice.key) }
                            </p>
                        </Show>
                    </li>
                </For>
            </ul>
        </div>
    </section>
}
