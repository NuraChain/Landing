{
    "name": "NuraLanding",
    "private": true,
    "version": "1.8.5",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "workspaces": [
        "application",
        "server"
    ],
    "azeroth": {
        "dev": "server"
    },
    "scripts": {
        "dev": "azeroth dev",
        "check": "azeroth check",
        "build": "azeroth build",
        "test": "azeroth test",
        "start": "npm start --workspace server",
        "test:watch": "npm run test:watch --workspace application",
        "test:unit": "npm run test:unit --workspace application",
        "test:integration": "npm run test:integration --workspace application",
        "test:fuzz": "npm run test:fuzz --workspace application",
        "test:security": "npm run test:security --workspace application",
        "test:i18n": "npm run test:i18n --workspace application",
        "test:shuffle": "npm run test:shuffle --workspaces --if-present",
        "test:server": "npm test --workspace server",
        "coverage": "npm run coverage --workspace application",
        "qa:visual": "node scripts/visual-qa.mjs",
        "qa:browser": "node scripts/browser-qa.mjs",
        "whitepaper:pdf": "node scripts/whitepaper-pdf.ts",
        "og:image": "node scripts/og-image.ts",
        "icons": "node scripts/icons.ts"
    },
    "devDependencies": {
        "@azerothjs/cli": "2.1.0",
        "@vitest/coverage-v8": "^5.0.3"
    }
}
