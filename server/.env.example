# Copy to .env for local overrides. NEVER commit .env - it is gitignored for a reason, and
# once the admin key below is real, that file is the only thing standing between a visitor
# and your dashboard. Read by the loadConfig block in src/main.ts.

PORT=5000

# Left unset on purpose. `azeroth dev` declares NODE_ENV=development for its children, and
# `npm start` is the production command - pinning it here would make `npm start` serve the
# dev app and 404 the built client. Set it only to force a mode.
# NODE_ENV=development

# The origin the site names itself by. Canonical tags, Open Graph urls, JSON-LD and
# /sitemap.xml are all built from it, so a deployment served from a different host must set
# this or every one of those points somewhere the site is not actually served.
SITE_URL=https://nurachain.net

# ON whenever anything terminates TLS or forwards to this process - nginx, Caddy, a
# Cloudflare tunnel. It is not a tuning knob: without it the rate limiter and the login
# throttle key on the TCP peer, which behind a proxy is the PROXY, so every visitor on the
# internet shares one bucket of 200 requests a minute and the site starts refusing people
# at random. Leave it off only when this process is the thing listening on :443.
TRUST_PROXY=true

# Where the built client lives in production (the server serves it - one origin).
CLIENT_DIR=../application/dist

# The SSR bundle built by `vite build --ssr` (self-contained; renders 'server' pages).
SSR_ENTRY=../application/dist-server/entry.server.js

# The devtools bridge's shared secret (development only). Leave it unset and the bridge
# simply does not attach. Generate one with:
#   node -e "console.log(crypto.randomUUID())"
DEVTOOLS_TOKEN=
