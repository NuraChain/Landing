import { For, Show } from 'azerothjs';

import { Check, Contrast, Languages, Menu, Moon, Sun, X } from 'lucide';

import { LOCALES, nativeName, useLocale } from '../stores/locale';
import { useTheme } from '../stores/theme';
import type { Theme } from '../stores/theme';

import { flagSrc } from './flag-icon';
import { icon } from './icon';

type SectionId = 'wallet' | 'tokenomics' | 'chain' | 'explorer' | 'social';

// Mutable, not `as const`: `<For each>` takes `unknown[]`, and a readonly tuple both
// fails to assign and collapses the row parameter to `unknown`.
const SECTIONS: SectionId[] = ['wallet', 'tokenomics', 'chain', 'explorer', 'social'];

const GLYPH: Record<Theme, typeof Moon> = { dark: Moon, light: Sun, contrast: Contrast };

/**
 * Sticky header that condenses once the page scrolls.
 *
 * Anchor navigation rather than routes: the whole landing page is one document, so a
 * router hop here would tear down and rebuild content the visitor is already looking at.
 */
export default component Header()
{
    const { t, locale, choose } = useLocale();
    const { theme, cycle } = useTheme();

    state scrolled = false;
    state menuOpen = false;
    state langOpen = false;

    effect
    {
        const onScroll = (): void => { scrolled = window.scrollY > 8; };

        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });

        cleanup { window.removeEventListener('scroll', onScroll); }
    }

    // A hash link leaves the menu open behind the section it jumped to, which reads as a
    // broken overlay on a phone.
    const jump = (): void => { menuOpen = false; };

    // Escape closes, and the page behind stops scrolling. Without the lock, a drag on the
    // drawer scrolls the document underneath it and the whole thing feels like a web page
    // rather than an app.
    effect
    {
        if (!menuOpen)
        {
            return;
        }

        const onKey = (event: KeyboardEvent): void =>
        {
            if (event.key === 'Escape')
            {
                menuOpen = false;
            }
        };

        const previous = document.body.style.overflow;

        document.body.style.overflow = 'hidden';
        document.addEventListener('keydown', onKey);

        cleanup
        {
            document.body.style.overflow = previous;
            document.removeEventListener('keydown', onKey);
        }
    }

    // Same contract as the drawer above: Escape closes the language modal and the page
    // behind it stops scrolling while it is up.
    effect
    {
        if (!langOpen)
        {
            return;
        }

        const onKey = (event: KeyboardEvent): void =>
        {
            if (event.key === 'Escape')
            {
                langOpen = false;
            }
        };

        const previous = document.body.style.overflow;

        document.body.style.overflow = 'hidden';
        document.addEventListener('keydown', onKey);

        cleanup
        {
            document.body.style.overflow = previous;
            document.removeEventListener('keydown', onKey);
        }
    }

    const label = (id: SectionId): string => t().nav[id];

    { /* The bar is a floating card, so the surface - border, background, blur - moves to
         the INNER element and the sticky <header> stays a transparent full-width rail. It
         has to: the rail is what holds the sticky position and the side gutters, and an
         inset rounded box cannot do both jobs at once. `mt-4` matches `top-4` so the gap
         above the card is the same 16px at rest as it is once stuck - offsetting only the
         stuck state would make the header jump on the first scroll. */ }
    <header class="sticky top-4 z-50 mt-4 px-4">
        { /* The card carries a surface at BOTH scroll positions. It used to go fully
             transparent at rest, which was fine when the bar was full-bleed and its edges
             were the viewport's - but a floating card with no border and no background has
             nothing to read as inset, so at scroll 0 it just looked full width again. Rest
             is the quiet version of the same card, not the absence of one; scrolling only
             firms it up. */ }
        <div
            class={ () => 'mx-auto flex h-16 max-w-6xl items-center gap-3 rounded-2xl border px-5 transition-colors duration-300 '
                + (scrolled ? 'border-line bg-bg/85 backdrop-blur-lg' : 'border-line/60 bg-surface/60 backdrop-blur-md') }
        >
            <a href="#top" class="me-auto flex items-center gap-2 text-base font-semibold tracking-tight text-ink">
                { /* Decorative: `alt=""` on purpose, because the brand name sits right
                     beside it inside the same link. A real alt here would make a screen
                     reader announce the name twice. */ }
                <img src="/icon.png" alt="" width="28" height="28" class="size-7 rounded-lg" />
                { t().brand }
            </a>

            <nav class="hidden items-center gap-1 md:flex" aria-label={ t().nav.wallet }>
                <For each={ SECTIONS } key={ (id) => id } let={ id }>
                    <a
                        href={ `#${ id }` }
                        class="rounded-lg px-3 py-2 text-sm text-muted transition-colors hover:bg-elevated hover:text-ink"
                    >
                        { label(id) }
                    </a>
                </For>
            </nav>

            <button
                type="button"
                class="grid size-9 place-items-center rounded-lg text-muted transition-colors hover:bg-elevated hover:text-ink"
                aria-label={ `${ t().theme.label }: ${ t().theme[theme()] }` }
                onClick={ () => cycle() }
            >
                { () => icon(GLYPH[theme()], 'size-[18px]') }
            </button>

            <button
                type="button"
                class="grid size-9 place-items-center rounded-lg text-muted transition-colors hover:bg-elevated hover:text-ink"
                aria-label={ t().nav.language }
                aria-haspopup="dialog"
                aria-expanded={ () => langOpen ? 'true' : 'false' }
                onClick={ () => langOpen = true }
            >
                { icon(Languages, 'size-[18px]') }
            </button>

            <a
                href="#wallet"
                class="hidden h-9 items-center rounded-lg bg-accent px-4 text-sm font-semibold text-accent-ink transition-colors hover:bg-accent-hover sm:flex"
            >
                { t().nav.download }
            </a>

            <button
                type="button"
                class="grid size-9 place-items-center rounded-lg text-muted hover:bg-elevated hover:text-ink md:hidden"
                aria-label={ () => menuOpen ? t().nav.closeMenu : t().nav.openMenu }
                aria-expanded={ () => menuOpen ? 'true' : 'false' }
                onClick={ () => menuOpen = !menuOpen }
            >
                { () => icon(menuOpen ? X : Menu, 'size-5') }
            </button>
        </div>

        <Show when={ menuOpen }>
            <Portal>
                { /* ONE child. `Portal` appends a single node, so handing it the scrim and
                     the panel as siblings throws at append time - the same one-element rule
                     a `<For>` row and a route component follow. The wrapper is unstyled and
                     both children are `fixed`, so it intercepts nothing. */ }
                <div class="md:hidden">
                { /* Scrim first so the panel stacks above it. Tapping it closes, which is
                     the gesture people try before hunting for an X. */ }
                    <div
                        class="fixed inset-0 z-[60] bg-black/60 backdrop-blur-sm"
                        onClick={ () => menuOpen = false }
                ></div>

                { /* Anchored to the inline-END edge, so it slides from the right in English
                     and from the LEFT in Persian. A drawer pinned to `right` would come from
                     the wrong side of an RTL page and read as a mistake. */ }
                    <nav
                        class="drawer fixed inset-y-0 end-0 z-[61] flex w-[min(19rem,85vw)] flex-col gap-1 border-s border-line bg-surface p-4 shadow-2xl motion-safe:animate-[drawer_220ms_ease-out] md:hidden"
                        style="padding-top: max(1rem, env(safe-area-inset-top)); padding-bottom: max(1rem, env(safe-area-inset-bottom));"
                        aria-label={ t().nav.wallet }
                    >
                        <button
                            type="button"
                            class="mb-2 grid size-11 place-items-center self-end rounded-lg text-muted hover:bg-elevated hover:text-ink"
                            aria-label={ t().nav.closeMenu }
                            onClick={ () => menuOpen = false }
                        >
                        { icon(X, 'size-5') }
                        </button>

                        <For each={ SECTIONS } key={ (id) => id } let={ id }>
                            <a
                                href={ `#${ id }` }
                                class="rounded-xl px-4 py-3 text-base text-muted transition-colors hover:bg-elevated hover:text-ink"
                                onClick={ () => jump() }
                            >
                                { label(id) }
                            </a>
                        </For>

                        <a
                            href="#wallet"
                            class="mt-3 flex h-12 items-center justify-center rounded-xl bg-accent font-semibold text-accent-ink"
                            onClick={ () => jump() }
                        >
                        { t().nav.download }
                        </a>
                    </nav>
                </div>
            </Portal>
        </Show>

        { /* Ten languages outgrew a toggle, and a modal outgrew a dropdown: a centred
             dialog holds a two-column grid without fighting the header card for space, and
             it works identically at every breakpoint. Each row names its language in
             itself - a Persian speaker hunting through an English page should meet
             "فارسی", not "Persian" - and `lang` per row keeps screen readers pronouncing
             each name in its own language. Flags are `alt=""` on purpose: the name sits
             right beside them, and a flag is a scanning aid, not the information. */ }
        <Show when={ langOpen }>
            <Portal>
                { /* ONE child, same as the drawer: `Portal` appends a single node. */ }
                <div>
                    <div
                        class="fixed inset-0 z-[80] bg-black/60 backdrop-blur-sm"
                        onClick={ () => langOpen = false }
                    ></div>

                    <div
                        role="dialog"
                        aria-modal="true"
                        aria-label={ t().nav.language }
                        class="fixed left-1/2 top-1/2 z-[81] max-h-[85vh] w-[min(26rem,calc(100vw-2rem))] -translate-x-1/2 -translate-y-1/2 overflow-y-auto rounded-2xl border border-line bg-surface p-4 shadow-2xl"
                    >
                        <div class="mb-3 flex items-center justify-between gap-3">
                            <h2 class="flex items-center gap-2 font-semibold text-ink">
                                { icon(Languages, 'size-[18px]') }
                                { t().nav.language }
                            </h2>

                            <button
                                type="button"
                                class="grid size-9 place-items-center rounded-lg text-muted hover:bg-elevated hover:text-ink"
                                aria-label={ t().nav.closeMenu }
                                onClick={ () => langOpen = false }
                            >
                                { icon(X, 'size-5') }
                            </button>
                        </div>

                        <div class="grid grid-cols-2 gap-1.5">
                            <For each={ () => [...LOCALES] } key={ (id) => id } let={ id }>
                                <button
                                    type="button"
                                    lang={ id }
                                    class={ () => 'flex items-center gap-2.5 rounded-xl border px-3 py-2.5 text-sm transition-colors '
                                        + (locale() === id
                                            ? 'border-accent/50 bg-accent-soft text-ink'
                                            : 'border-transparent text-muted hover:bg-elevated hover:text-ink') }
                                    onClick={ () => { choose(id); langOpen = false; } }
                                >
                                    <img
                                        src={ flagSrc(id) }
                                        alt=""
                                        width="24"
                                        height="18"
                                        class="h-[18px] w-6 shrink-0 rounded-[4px] object-cover"
                                    />
                                    <span class="min-w-0 flex-1 truncate text-start">{ nativeName(id) }</span>
                                    <Show when={ () => locale() === id }>
                                        { icon(Check, 'size-4 shrink-0 text-accent') }
                                    </Show>
                                </button>
                            </For>
                        </div>
                    </div>
                </div>
            </Portal>
        </Show>
    </header>
}
