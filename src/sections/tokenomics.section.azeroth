import { For } from 'azerothjs';

import { ALLOCATIONS, SUPPLY } from '../lib/content/site';

import Card from '../components/card.component.azeroth';
import SectionHeading from '../components/section-heading.component.azeroth';

import { useLocale } from '../stores/locale';

/**
 * Categorical hues, validated rather than chosen by eye.
 *
 * The first attempt paired a blue and a violet that measured ΔE 0.3 under protanopia and
 * 8.7 with full colour vision: two segments nobody could tell apart. These are re-stepped
 * so the worst ADJACENT pair is ΔE 13.9 protan / 16.8 normal / 12.2 tritan, with similar
 * hues kept non-adjacent. Fixed order, never cycled: a slot belongs to an entity, so
 * adding or removing a row must not repaint the survivors - which is why the green was
 * APPENDED for the sixth allocation rather than slotted in where it looked best.
 *
 * Validated on adjacent pairs against all three theme surfaces, not chosen by eye. The
 * pairing only holds for THIS order; see the note on ALLOCATIONS before reordering. Teal
 * measures 2.94:1 on the white surface, under the 3:1 floor - the direct labels below are
 * what make that legal, so they are not optional decoration.
 */
const HUES: string[] = ['#22a89b', '#c07f26', '#6b8afd', '#e15a7c', '#a274d6', '#4f9e52'];

export default component TokenomicsSection()
{
    const { locale, t } = useLocale();

    state active = null as string | null;

    // Locale-aware grouping, so Persian gets Persian digits and separators for free.
    const number = (value: number): string => new Intl.NumberFormat(locale()).format(value);
    const percent = (value: number): string =>
        new Intl.NumberFormat(locale(), { style: 'percent', maximumFractionDigits: 1 }).format(value / 100);

    <section id="tokenomics" class="border-t border-line px-5 py-16 sm:py-20">
        <div class="mx-auto max-w-4xl">
            <SectionHeading title={ t().tokenomics.title } subtitle={ t().tokenomics.subtitle } />

            { /* Two headline figures. A number this important is read, not decoded off an
                 axis, so it is a stat tile rather than another mark on the chart. */ }
            <div class="mt-8 grid gap-3 sm:grid-cols-2">
                <Card>
                    <p class="text-sm text-muted">{ t().tokenomics.totalSupply }</p>
                    <p class="mt-1 font-mono text-2xl font-semibold text-ink sm:text-3xl">
                        { () => number(SUPPLY.total) }
                    </p>
                </Card>
                <Card>
                    <p class="text-sm text-muted">{ t().tokenomics.circulating }</p>
                    <p class="mt-1 font-mono text-2xl font-semibold text-ink sm:text-3xl">
                        { () => number(SUPPLY.circulating) }
                    </p>
                </Card>
            </div>

            <h3 class="mt-10 text-sm font-semibold text-faint">{ t().tokenomics.allocation }</h3>

            { /* A segmented bar, not a donut: this is parts-of-a-whole across 6 categories,
                 where comparing segment LENGTHS along one axis is the thing a reader
                 actually does. Angles are harder to compare than lengths. The 2px surface
                 gap between fills is what keeps two adjacent segments from reading as one. */ }
            <div
                class="mt-3 flex h-11 w-full gap-[2px] overflow-hidden rounded-xl"
                role="img"
                aria-label={ () => ALLOCATIONS
                    .map((a) => `${ t().tokenomics.allocations[a.key] } ${ percent(a.percent) }`)
                    .join(', ') }
            >
                <For each={ () => [...ALLOCATIONS] } key={ (slice) => slice.key } let={ slice } index={ index }>
                    <div
                        class="h-full transition-opacity duration-200"
                        style={ () => `flex: ${ slice.percent }; background: ${ HUES[index % HUES.length] };`
                            + (active === null || active === slice.key ? '' : 'opacity: 0.35;') }
                    ></div>
                </For>
            </div>

            { /* Every segment is direct-labelled here, which is what lets the palette sit
                 at its measured separation safely: identity never rests on colour alone. */ }
            <ul class="mt-5 grid gap-x-6 gap-y-2.5 sm:grid-cols-2">
                <For each={ () => [...ALLOCATIONS] } key={ (slice) => slice.key } let={ slice } index={ index }>
                    <li
                        class="flex items-center gap-2.5 rounded-lg px-1 py-1 transition-colors"
                        onMouseEnter={ () => active = slice.key }
                        onMouseLeave={ () => active = null }
                    >
                        <span
                            class="size-3 shrink-0 rounded-[3px]"
                            style={ `background: ${ HUES[index % HUES.length] }` }
                        ></span>
                        <span class="min-w-0 flex-1 truncate text-sm text-ink">
                            { () => t().tokenomics.allocations[slice.key] }
                        </span>
                        <span class="shrink-0 font-mono text-sm text-muted">{ () => percent(slice.percent) }</span>
                    </li>
                </For>
            </ul>
        </div>
    </section>
}
